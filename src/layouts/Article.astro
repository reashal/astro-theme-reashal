---
import type { MarkdownHeading } from "astro";
import "../styles/md.css";
import ArticleToc from "../components/ArticleToc.astro";
import Giscus from "../components/Giscus.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import type { ArticleFrontmatter } from "../types";
import {
    estimateReadingMinutes,
    getDocsArticles,
    sortArticlesByDate,
} from "../utils/articles";
import { AUTHOR_INFO } from "../consts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
    frontmatter: ArticleFrontmatter;
    headings?: MarkdownHeading[];
    rawContent?: () => string;
}

const {
    frontmatter,
    headings = [],
    rawContent: getRawContent,
} = Astro.props as Props;
const tags = frontmatter.tags || [];

// 随笔可省略署名和来源：署名回退至站点作者，来源始终指向当前随笔的规范地址。
const articleAuthor = frontmatter.author?.trim() || AUTHOR_INFO.name;
const articleSource =
    frontmatter.source || new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const normalizePath = (path: string) =>
    path.length > 1 ? path.replace(/\/+$/, "") : path;
const currentPath = normalizePath(Astro.url.pathname);
const isDocsArticle = currentPath.startsWith("/docs/");
const rawArticle = isDocsArticle ? (getRawContent?.() ?? "") : "";
const readingMinutes = estimateReadingMinutes(rawArticle);
const tocHeadings = headings.filter(
    (heading) => heading.depth >= 2 && heading.depth <= 6,
);
const hasArticleToc = isDocsArticle && tocHeadings.length >= 3;
const rawPublishedDate = frontmatter.pubDate as string | Date;
const publishedDate =
    rawPublishedDate instanceof Date
        ? rawPublishedDate.toISOString().slice(0, 10)
        : String(rawPublishedDate).slice(0, 10);
const rawUpdatedDate = frontmatter.updatedDate as string | Date | undefined;
const updatedDate =
    rawUpdatedDate instanceof Date
        ? rawUpdatedDate.toISOString().slice(0, 10)
        : rawUpdatedDate
          ? String(rawUpdatedDate).slice(0, 10)
          : undefined;
const showUpdatedDate = updatedDate && updatedDate !== publishedDate;

const allArticles = getDocsArticles();
const articlesByDate = sortArticlesByDate(allArticles, "asc");
const currentArticleIndex = articlesByDate.findIndex(
    (article) => normalizePath(article.url) === currentPath,
);
const previousArticle =
    currentArticleIndex > 0
        ? articlesByDate[currentArticleIndex - 1]
        : undefined;
const nextArticle =
    currentArticleIndex >= 0 &&
    currentArticleIndex < articlesByDate.length - 1
        ? articlesByDate[currentArticleIndex + 1]
        : undefined;
const relatedArticles = isDocsArticle
    ? allArticles
          .filter((article) => normalizePath(article.url) !== currentPath)
          .map((article) => ({
              article,
              sharedTags: (article.frontmatter.tags ?? []).filter((tag) =>
                  tags.includes(tag),
              ),
          }))
          .filter(({ sharedTags }) => sharedTags.length > 0)
          .sort((a, b) => {
              if (b.sharedTags.length !== a.sharedTags.length) {
                  return b.sharedTags.length - a.sharedTags.length;
              }
              return (
                  new Date(b.article.frontmatter.pubDate).getTime() -
                  new Date(a.article.frontmatter.pubDate).getTime()
              );
          })
          .slice(0, 2)
    : [];

const formatDate = (date: string) => {
    const [year, month, day] = date.split("-").map(Number);
    return `${year}年${month}月${day}日`;
};
---

<BaseLayout
    pageTitle={frontmatter.title}
    pageDescription={frontmatter.desc}
    pageType={isDocsArticle ? "article" : "website"}
    publishedTime={isDocsArticle ? publishedDate : undefined}
    modifiedTime={isDocsArticle ? updatedDate : undefined}
    pageTags={isDocsArticle ? tags : []}
    enableMediaViewer
>
    <ReadingProgress />
    <article
        class="article-container doc"
        data-pagefind-body
        data-pagefind-filter="section:docs"
    >
        {
            isDocsArticle ? (
                <header id="article-start" class="article-lead">
                    <h1 class="article-title" data-pagefind-meta="title">
                        {frontmatter.title}
                    </h1>
                    <p class="article-description">{frontmatter.desc}</p>
                    <div class="article-lead-details">
                        <div class="article-meta">
                            <time datetime={publishedDate}>
                                <i
                                    class="iconfont icon-date"
                                    aria-hidden="true"
                                />
                                {formatDate(publishedDate)}
                            </time>
                            {
                                showUpdatedDate && (
                                    <time datetime={updatedDate}>
                                        <svg
                                            aria-hidden="true"
                                            viewBox="0 0 24 24"
                                        >
                                            <path d="m5.2 18.8.8-3.5L15.7 5.6a2.1 2.1 0 0 1 3 3L9 18.3l-3.8.5Z" />
                                            <path d="m14.3 7 2.7 2.7" />
                                        </svg>
                                        更新于 {formatDate(updatedDate)}
                                    </time>
                                )
                            }
                            <span>
                                <svg aria-hidden="true" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="8.5" />
                                    <path d="M12 7.5V12l3 2" />
                                </svg>
                                约 {readingMinutes} 分钟
                            </span>
                        </div>
                        {tags.length > 0 && (
                            <nav
                                class="article-lead-tags"
                                aria-label="文章标签"
                            >
                                {tags.map((tag) => (
                                    <a
                                        href={`/tags/${encodeURIComponent(tag)}`}
                                    >
                                        <i
                                            class="iconfont icon-tag"
                                            aria-hidden="true"
                                        />
                                        {tag}
                                    </a>
                                ))}
                            </nav>
                        )}
                    </div>
                </header>
            ) : (
                <h1 class="article-search-meta" data-pagefind-meta="title">
                    {frontmatter.title}
                </h1>
            )
        }
        {hasArticleToc && <ArticleToc headings={tocHeadings} />}
        <span
            class="article-search-meta"
            data-pagefind-meta="description"
            aria-hidden="true"
        >
            {frontmatter.desc}
        </span>
        <span
            class="article-search-meta"
            data-pagefind-meta="tags"
            aria-hidden="true"
        >
            {tags.join(" ")}
        </span>
        <div class="article-content">
            <slot />
        </div>
        <section class="article-copy" data-pagefind-ignore="all">
            <div>
                本文作者：<a href={articleSource} target="_blank" rel="noopener noreferrer"
                    >{articleAuthor}</a
                >
            </div>
            <div>
                本文来源：<a href={articleSource} target="_blank" rel="noopener noreferrer"
                    >{articleSource}</a
                >
            </div>
            <div class="article-copy-info">
                许可协议：<a
                    href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans"
                    target="_blank"
                    rel="noopener noreferrer">CC BY-NC-SA 4.0</a
                >
            </div>
            <div class="article-copy-info">
                本站随笔均为原创，涉及隐私且时效性较强，不允许任何人以任何形式转载。
            </div>
            <div class="article-copy-info">
                本站笔记多对原始作品作出修改，允许非商业用途转载，转载时请注明出处。
            </div>
        </section>
        {
            (previousArticle || nextArticle) && (
                <nav
                    class="article-neighbors"
                    aria-label="相邻随笔"
                    data-pagefind-ignore="all"
                >
                    {previousArticle && (
                        <a
                            href={previousArticle.url}
                            class="article-neighbor article-neighbor-previous"
                            rel="prev"
                        >
                            <span class="article-neighbor-direction">
                                <i
                                    class="iconfont icon-left"
                                    aria-hidden="true"
                                />
                                上一篇
                            </span>
                            <strong>{previousArticle.frontmatter.title}</strong>
                        </a>
                    )}
                    {nextArticle && (
                        <a
                            href={nextArticle.url}
                            class="article-neighbor article-neighbor-next"
                            rel="next"
                        >
                            <span class="article-neighbor-direction">
                                下一篇
                                <i
                                    class="iconfont icon-right"
                                    aria-hidden="true"
                                />
                            </span>
                            <strong>{nextArticle.frontmatter.title}</strong>
                        </a>
                    )}
                </nav>
            )
        }
        {
            relatedArticles.length > 0 && (
                <section
                    class="article-related"
                    aria-labelledby="article-related-title"
                    data-pagefind-ignore="all"
                >
                    <h2 id="article-related-title">延伸阅读</h2>
                    <div class="article-related-list">
                        {relatedArticles.map(({ article, sharedTags }) => (
                            <a
                                class="article-related-item"
                                href={article.url}
                            >
                                <span class="article-related-copy">
                                    <strong>
                                        {article.frontmatter.title}
                                    </strong>
                                    <small>
                                        共同标签 · {sharedTags.join(" · ")}
                                    </small>
                                </span>
                                <svg
                                    aria-hidden="true"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M5 12h13" />
                                    <path d="m14 7 5 5-5 5" />
                                </svg>
                            </a>
                        ))}
                    </div>
                </section>
            )
        }
        <Giscus />
    </article>
    <script src="../scripts/code-copy.ts"></script>
</BaseLayout>
