---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Moment from "../components/Moment.astro";
import { SITE_INFO } from "../consts";
import { paginateMoments } from "../utils/moments";
import "../styles/moments.css";

const allMoments = await getCollection("moments");
const momentPages = paginateMoments(allMoments);
const initialMoments = momentPages[0]?.moments ?? [];
const pageCount = momentPages.length;
const nextPage = pageCount > 1 ? 2 : 1;

const pageMeta = {
    title: "动态",
    desc: "以碎片化的记录汇聚时光的川流",
};
---

<BaseLayout pageTitle={pageMeta.title} pageDescription={pageMeta.desc}>
    <article class="article-container">
        <section
            class="moments"
            id="moments-feed"
            data-page-count={pageCount}
            data-next-page={nextPage}
        >
            <h1>动态</h1>
            <div id="moments-list">
                {initialMoments.map((moment) => <Moment moment={moment} />)}
            </div>
            <button
                class="moments-loader"
                id="moments-loader"
                type="button"
                aria-live="polite"
                hidden={pageCount <= 1}
            >
                <span class="moments-loader-mark" aria-hidden="true"></span>
                <span class="moments-loader-text">过往还在岁月笺底</span>
            </button>
            <footer class="moments-footer" hidden={pageCount > 1}>
                <p class="end-tip">{SITE_INFO.endTip}</p>
                {SITE_INFO.icpNo && (
                    <p class="icp-info">
                        <a href={SITE_INFO.icpLink || "https://beian.miit.gov.cn/"} target="_blank" rel="noopener noreferrer">
                            {SITE_INFO.icpNo}
                        </a>
                    </p>
                )}
            </footer>
        </section>
    </article>
</BaseLayout>

<script src="../scripts/moments-feed.ts"></script>
<script src="../scripts/music-player.ts"></script>
<script src="../scripts/media-loader.ts"></script>
