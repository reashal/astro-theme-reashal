---
import "../styles/showcase.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Giscus from "../components/Giscus.astro";
import showcaseConfigJson from "../showcase.json";
import { showcasesSchema } from "../showcase-types";
import { AUTHOR_INFO } from "../consts";
import { getPageConfig } from "../utils/pages";

const showcaseConfig = showcasesSchema.parse(showcaseConfigJson);
const showcases = Object.entries(showcaseConfig.showcases).map(([id, config]) => ({
    id,
    config,
    icon: id === "links" ? "iconfont icon-plane" : "iconfont icon-pc",
}));

const pageMeta = getPageConfig("/show");
const siteOrigin = Astro.site ?? Astro.url.origin;
const siteUrl = new URL("/", siteOrigin);
const avatarUrl = new URL(AUTHOR_INFO.avatar, siteOrigin);

const getInitial = (title: string) => title.charAt(0).toUpperCase();
const hasValidImage = (image: string | undefined): boolean => !!image && image.trim() !== "";
const friendLinkSections = new Set(["互链朋友", "单向推荐"]);
---

<BaseLayout
    pageTitle={pageMeta.title}
    pageDescription={pageMeta.description}
    enableMediaViewer
>
    <article class="article-container showcase">
        <nav class="showcase-nav" aria-label="展示分类">
            {showcases.map(({ id, config, icon }, index) => (
                <a
                    href={`/show#${id}`}
                    class={index === 0 ? "active" : ""}
                    data-showcase-tab={id}
                    aria-current={index === 0 ? "page" : undefined}
                >
                    <i class={icon}></i>
                    <span>{config.title}</span>
                </a>
            ))}
        </nav>

        {showcases.map(({ id, config }, index) => (
            <div
                class={id === "links" ? "showcase-links-panel" : undefined}
                data-showcase-panel={id}
                hidden={index !== 0}
            >
                {config.intro && config.intro.length > 0 && (
                    <>
                        <h2 class="showcase-h showcase-intro">写在前面</h2>
                        {config.intro.map((paragraph) => (
                            <p class="showcase-p">{paragraph}</p>
                        ))}
                    </>
                )}

                {config.sections.map((section) => {
                    const isLinksPanel = id === "links";
                    const isFriendLinkSection = isLinksPanel && friendLinkSections.has(section.title);

                    return (
                    <>
                        <h2 class="showcase-h">{section.title}</h2>
                        <div
                            class:list={[
                                "showcase-body",
                                isLinksPanel && "showcase-link-grid",
                                isFriendLinkSection
                                    ? "showcase-link-grid--friends"
                                    : isLinksPanel && "showcase-link-grid--mirrors",
                            ]}
                        >
                            {section.cards.map((card) => {
                                const hasImage = hasValidImage(card.image);
                                const hasLink = card.link && card.link.trim() !== "";
                                const CardWrapper = hasLink ? "a" : "div";
                                const linkProps = hasLink
                                    ? {
                                        href: card.link,
                                        target: "_blank",
                                        rel: "noopener noreferrer",
                                    }
                                    : {};

                                if (isLinksPanel) {
                                    return (
                                        <CardWrapper
                                            {...linkProps}
                                            class:list={[
                                                "showcase-link-card",
                                                isFriendLinkSection
                                                    ? "showcase-link-card--friend"
                                                    : "showcase-link-card--mirror",
                                            ]}
                                            aria-label={hasLink
                                                ? `${isFriendLinkSection ? "访问" : "打开"} ${card.title}：${card.description}`
                                                : undefined}
                                        >
                                            {isFriendLinkSection && (
                                                <span
                                                    class={`showcase-link-avatar ${!hasImage ? "no-image" : ""}`}
                                                    data-initial={getInitial(card.title)}
                                                >
                                                    {hasImage && (
                                                        <img
                                                            src={card.image}
                                                            alt={`${card.title}头像`}
                                                            loading="lazy"
                                                            decoding="async"
                                                        />
                                                    )}
                                                </span>
                                            )}
                                            <span class="showcase-link-copy">
                                                <strong>{card.title}</strong>
                                                {isFriendLinkSection ? (
                                                    <span class="showcase-link-description-viewport">
                                                        <span data-link-description>{card.description}</span>
                                                    </span>
                                                ) : (
                                                    <small>{card.description}</small>
                                                )}
                                            </span>
                                        </CardWrapper>
                                    );
                                }

                                return (
                                    <CardWrapper {...linkProps} class={`showcase-${card.imageMode}`}>
                                        {(card.imageMode === "icon-simple" || card.imageMode === "app-card") && (
                                            <div
                                                class={`showcase-avatar ${!hasImage ? "no-image" : ""}`}
                                                data-initial={getInitial(card.title)}
                                            >
                                                {hasImage && (
                                                    <img
                                                        src={card.image}
                                                        alt={card.title}
                                                        title={card.title}
                                                        loading="lazy"
                                                        decoding="async"
                                                        data-view-image={card.image?.startsWith("/") ? "" : undefined}
                                                        data-view-group={card.image?.startsWith("/") ? `showcase-${id}` : undefined}
                                                    />
                                                )}
                                            </div>
                                        )}
                                        {card.imageMode === "product-card" && (
                                            <div
                                                class={`showcase-large-image ${!hasImage ? "no-image" : ""}`}
                                                data-title={getInitial(card.title)}
                                            >
                                                {hasImage && (
                                                    <img
                                                        src={card.image}
                                                        alt={card.title}
                                                        title={card.title}
                                                        loading="lazy"
                                                        decoding="async"
                                                        data-view-image={card.image?.startsWith("/") ? "" : undefined}
                                                        data-view-group={card.image?.startsWith("/") ? `showcase-${id}` : undefined}
                                                    />
                                                )}
                                            </div>
                                        )}
                                        <div class="showcase-info">
                                            <h3>{card.title}</h3>
                                            {card.specs && card.specs.length > 0 && (
                                                <div class="showcase-specs">
                                                    {card.specs.map((spec) => (
                                                        <span class="showcase-spec">{spec}</span>
                                                    ))}
                                                </div>
                                            )}
                                            <div class="showcase-description">
                                                <p>{card.description}</p>
                                                {card.imageMode === "product-card" && (
                                                    <span class="showcase-description-full" aria-hidden="true">
                                                        {card.description}
                                                    </span>
                                                )}
                                            </div>
                                        </div>
                                    </CardWrapper>
                                );
                            })}
                        </div>
                    </>
                    );
                })}

                {config.showFooter === true && (
                    <section class="article-copy">
                        <div>名称：{AUTHOR_INFO.name}</div>
                        <div>网址：{siteUrl}</div>
                        <div>头像：{avatarUrl}</div>
                        <div>描述：{AUTHOR_INFO.detailDescription || AUTHOR_INFO.description}</div>
                    </section>
                )}

                {id === "links" && <Giscus />}
            </div>
        ))}
    </article>

    <script src="../scripts/showcase.ts"></script>
</BaseLayout>
