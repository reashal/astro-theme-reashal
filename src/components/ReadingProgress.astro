---
interface Props { article?: boolean; }
const { article = false } = Astro.props;
const progressLabel = article ? "阅读进度" : "页面进度";
const topLabel = article ? "回到篇首" : "回到顶部";
---
<div class="reading-position" data-reading-position>
    <div class="reading-position-caption">
        <label for="readingPosition">{progressLabel}</label>
        <output for="readingPosition" data-reading-percent>0%</output>
    </div>
    <div class="reading-position-controls">
        <div class="reading-position-meter" role="progressbar" aria-label={progressLabel} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden><span></span></div>
        <input id="readingPosition" type="range" min="0" max="100" step="0.1" value="0" aria-label={`${progressLabel}，拖动定位`} />
        <button type="button" data-reading-top aria-label={topLabel} title={topLabel}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6v12M19 12H9m4-4-4 4 4 4" /></svg>
        </button>
    </div>
</div>

<style>
    .reading-position { grid-area: 4 / 1 / 5 / 4; min-width: 0; padding: .35rem .6rem 0; }
    .reading-position-caption { display: flex; justify-content: space-between; align-items: center; color: var(--toc-island-muted); font-size: .68rem; font-variant-numeric: tabular-nums; }
    .reading-position-controls { display: flex; align-items: center; gap: .6rem; }
    input {
        --read-fill: 0%;
        --read-ink: color-mix(in srgb, var(--toc-island-active) 65%, var(--toc-island-muted));
        appearance: none;
        -webkit-appearance: none;
        min-width: 0;
        flex: 1;
        height: 44px;
        margin: 0;
        padding: 0;
        background: transparent;
        cursor: pointer;
        touch-action: none;
    }
    input::-webkit-slider-runnable-track { height: 2px; border-radius: 2px; background: linear-gradient(to right, var(--read-ink) var(--read-fill), var(--border-toc) var(--read-fill)); }
    input::-moz-range-track { height: 2px; border-radius: 2px; background: var(--border-toc); }
    input::-moz-range-progress { height: 2px; border-radius: 2px; background: var(--read-ink); }
    input::-webkit-slider-thumb {
        appearance: none;
        -webkit-appearance: none;
        width: 16px;
        height: 8px;
        margin-top: -3px;
        border-radius: 3px;
        background: var(--toc-island-text);
        border: 0;
        box-shadow: 0 0 0 3px var(--toc-island-panel), inset 0 -2px 0 var(--gloss-toc);
        cursor: grab;
        transition: transform .24s cubic-bezier(.22,1,.36,1);
    }
    input::-moz-range-thumb {
        width: 16px;
        height: 8px;
        border-radius: 3px;
        background: var(--toc-island-text);
        border: 0;
        box-shadow: 0 0 0 3px var(--toc-island-panel), inset 0 -2px 0 var(--gloss-toc);
        cursor: grab;
        transition: transform .24s cubic-bezier(.22,1,.36,1);
    }
    input:active { cursor: grabbing; }
    input:active::-webkit-slider-thumb { cursor: grabbing; transform: scale(.94); }
    input:active::-moz-range-thumb { cursor: grabbing; transform: scale(.94); }
    input:disabled { cursor: default; opacity: .5; }
    input:disabled::-webkit-slider-thumb { cursor: default; }
    input:disabled::-moz-range-thumb { cursor: default; }
    .reading-position-meter { position: relative; flex: 1; min-width: 0; height: 44px; cursor: default; touch-action: pan-y; user-select: none; }
    .reading-position-meter::before, .reading-position-meter > span { position: absolute; inset: 21px 0 auto; height: 2px; border-radius: 2px; pointer-events: none; }
    .reading-position-meter::before { content: ""; background: var(--border-toc); }
    .reading-position-meter > span { background: color-mix(in srgb, var(--toc-island-active) 65%, var(--toc-island-muted)); transform: scaleX(var(--read-progress, 0)); transform-origin: left center; }
    .reading-position-meter[hidden], input[hidden] { display: none; }
    button { display: grid; place-items: center; flex: 0 0 44px; height: 44px; padding: 0; border: 0; border-radius: .5rem; background: transparent; color: var(--toc-island-muted); cursor: pointer; transition: transform .2s cubic-bezier(.22,1,.36,1); }
    button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    button:active { transform: translateY(1px) scale(.96); }
    @media (hover: hover) { button:hover { color: var(--toc-island-text); background: var(--surface-toc-selected); } }
    @media (hover: none) { button:active { background: var(--surface-toc-selected); } }
    input:focus-visible, button:focus-visible { outline: 2px solid var(--toc-island-active); outline-offset: 2px; border-radius: .5rem; }
    @media (prefers-reduced-motion: reduce) { button, input::-webkit-slider-thumb { transition: none; } input::-moz-range-thumb { transition: none; } }
</style>

<script>
    const position = document.querySelector<HTMLElement>("[data-reading-position]");
    const range = position?.querySelector<HTMLInputElement>("input");
    const meter = position?.querySelector<HTMLElement>(".reading-position-meter");
    const percent = position?.querySelector<HTMLOutputElement>("output");
    const topButton = position?.querySelector<HTMLButtonElement>("[data-reading-top]");
    const container = document.querySelector<HTMLElement>(".main");
    const content = document.querySelector<HTMLElement>(".article-container.doc .article-content");
    if (position && range && meter && percent && topButton && container) {
        let frame = 0;
        let returnFrame = 0;
        let revision = 0;
        let dragging = false;
        let progressFrame = 0;
        let displayedProgress = 0;
        let initialized = false;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const articleTools = position.closest<HTMLElement>("[data-article-toc]");
        const searchToggle = articleTools?.querySelector<HTMLButtonElement>("#docsSearchToggle");
        const progressLabel = range.getAttribute("aria-label")?.split("，")[0] || "页面进度";
        const isReadOnly = () => articleTools?.dataset.hasDirectory === "false" || searchToggle?.getAttribute("aria-expanded") === "true";
        const bounds = () => {
            if (!content) return { start: 0, distance: Math.max(0, container.scrollHeight - container.clientHeight) };
            const start = container.scrollTop + content.getBoundingClientRect().top - container.getBoundingClientRect().top;
            const end = Math.min(container.scrollHeight - container.clientHeight, start + content.offsetHeight - container.clientHeight);
            return { start: Math.max(0, start), distance: Math.max(0, end - start) };
        };
        const paint = (value: number) => {
            displayedProgress = value;
            range.value = String(value);
            range.style.setProperty("--read-fill", value + "%");
            percent.textContent = Math.round(value) + "%";
            range.setAttribute("aria-valuetext", Math.round(value) + "%");
            meter.style.setProperty("--read-progress", String(value / 100));
            meter.setAttribute("aria-valuenow", String(Math.round(value)));
        };
        const stopProgress = () => {
            cancelAnimationFrame(progressFrame);
            progressFrame = 0;
        };
        const followProgress = (value: number) => {
            stopProgress();
            // 拖拽与回顶已有实时位移，不叠加缓动，避免滑块落后于手势。
            if (!initialized || reducedMotion.matches || returnFrame || Math.abs(value - displayedProgress) < .1) {
                initialized = true;
                paint(value);
                return;
            }
            const from = displayedProgress;
            const started = performance.now();
            const tick = (now: number) => {
                const t = Math.min(1, (now - started) / 300);
                paint(from + (value - from) * (1 - (1 - t) ** 3));
                progressFrame = t < 1 ? requestAnimationFrame(tick) : 0;
            };
            progressFrame = requestAnimationFrame(tick);
        };
        const sync = () => {
            frame = 0;
            if (dragging) return;
            const { start, distance } = bounds();
            const readOnly = isReadOnly();
            position.toggleAttribute("data-readonly", readOnly);
            range.hidden = readOnly;
            meter.hidden = !readOnly;
            range.disabled = readOnly || distance === 0;
            range.setAttribute("aria-label", readOnly ? progressLabel : `${progressLabel}，拖动定位`);
            followProgress(distance ? Math.min(100, Math.max(0, (container.scrollTop - start) / distance * 100)) : 100);
        };
        const schedule = () => { if (!frame) frame = requestAnimationFrame(sync); };
        const release = () => {
            const run = ++revision;
            requestAnimationFrame(() => requestAnimationFrame(() => {
                if (run !== revision || dragging) return;
                delete position.dataset.readingSeeking;
                schedule();
            }));
        };
        const stopReturn = () => { cancelAnimationFrame(returnFrame); returnFrame = 0; };
        meter.addEventListener("wheel", (event) => {
            if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) event.preventDefault();
        }, { passive: false });
        range.addEventListener("pointerdown", () => {
            if (isReadOnly()) return;
            stopReturn();
            stopProgress();
            dragging = true;
            revision++;
            position.dataset.readingSeeking = "true";
        });
        range.addEventListener("input", () => {
            if (isReadOnly()) { sync(); return; }
            stopReturn();
            stopProgress();
            position.dataset.readingSeeking = "true";
            const value = Number(range.value);
            const { start, distance } = bounds();
            paint(value);
            container.scrollTo({ top: start + distance * value / 100, behavior: "instant" });
            if (!dragging) release();
        });
        const finishDrag = () => { if (dragging) { dragging = false; release(); } };
        window.addEventListener("pointerup", finishDrag);
        window.addEventListener("pointercancel", finishDrag);
        window.addEventListener("blur", finishDrag);
        topButton.addEventListener("click", () => {
            stopReturn();
            const run = ++revision;
            position.dataset.readingSeeking = "true";
            const start = container.scrollTop;
            const started = performance.now();
            const reduced = reducedMotion.matches;
            const tick = (now: number) => {
                if (run !== revision) return;
                const t = reduced ? 1 : Math.min(1, (now - started) / 420);
                container.scrollTo({ top: start * (1 - t) ** 3, behavior: "instant" });
                schedule();
                if (t < 1) returnFrame = requestAnimationFrame(tick);
                else { returnFrame = 0; release(); }
            };
            returnFrame = requestAnimationFrame(tick);
        });
        const interrupt = () => { stopReturn(); dragging = false; release(); };
        container.addEventListener("wheel", interrupt, { passive: true });
        container.addEventListener("touchstart", (event) => {
            if (event.target instanceof Node && !position.contains(event.target)) interrupt();
        }, { passive: true });
        container.addEventListener("scroll", schedule, { passive: true });
        position.closest("[data-article-toc]")?.addEventListener("article-tools:closed", interrupt);
        window.addEventListener("resize", schedule);
        const observer = new ResizeObserver(schedule);
        // 观察实际内容盒，动态追加和图片加载后重新计算可滚动范围。
        for (const child of container.children) observer.observe(child);
        if (content) observer.observe(content);
        observer.observe(container);
        if (searchToggle) {
            new MutationObserver(() => {
                dragging = false;
                sync();
            }).observe(searchToggle, { attributes: true, attributeFilter: ["aria-expanded"] });
        }
        sync();
    }
</script>
