<button
    type="button"
    class="reading-flight"
    aria-label="阅读进度 0%，点击飞回篇首"
    title="飞回篇首"
    data-reading-flight
    tabindex="-1"
>
    <span class="reading-flight-route" aria-hidden="true">
        <span class="reading-flight-trail" data-reading-flight-trail></span>
    </span>
    <span
        class="reading-flight-aircraft"
        aria-hidden="true"
    >
        <span class="reading-flight-aircraft-body">
            <span class="reading-flight-exhaust">
                <i></i>
                <i></i>
                <i></i>
            </span>
            <svg
                class="reading-flight-plane"
                viewBox="0 0 36 40"
                focusable="false"
            >
                <path
                    class="reading-flight-plane-wing"
                    d="M17.58 36.84c-.25.48-.94.43-1.12-.08L2.74 6.22c-.4-.9.14-1.48 1.08-1.18l13.3 3.38c.52.13.88.6.88 1.14v25.88c0 .49-.14.97-.42 1.4Z"
                ></path>
                <path
                    class="reading-flight-plane-wing reading-flight-plane-wing-far"
                    d="M18.42 36.84c.25.48.94.43 1.12-.08L33.26 6.22c.4-.9-.14-1.48-1.08-1.18l-13.3 3.38c-.52.13-.88.6-.88 1.14v25.88c0 .49-.14.97-.42 1.4Z"
                ></path>
                <path
                    class="reading-flight-plane-flap"
                    d="M18 9.18 11.92 23.56 18 20.88Z"
                ></path>
                <path
                    class="reading-flight-plane-flap reading-flight-plane-flap-far"
                    d="M18 9.18 24.08 23.56 18 20.88Z"
                ></path>
                <path
                    class="reading-flight-plane-fold"
                    d="M18 9.28v25.86"
                ></path>
                <path
                    class="reading-flight-plane-edge"
                    d="m3.82 5.58 13.3 3.46M32.18 5.58l-13.3 3.46"
                ></path>
            </svg>
            <span class="reading-flight-headlights">
                <i></i>
                <i></i>
            </span>
        </span>
    </span>
</button>

<style>
    .reading-flight {
        --reading-progress: 0;
        --flight-rgb: var(--rgb-flight);

        position: fixed;
        top: 50%;
        right: .18rem;
        z-index: 998;
        width: 2.9rem;
        height: var(--edge-control-length);
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--color-flight-wing);
        cursor: pointer;
        opacity: 0;
        pointer-events: none;
        transform: translate(.65rem, -50%);
        transition:
            opacity .25s cubic-bezier(.22, 1, .36, 1),
            transform .25s cubic-bezier(.22, 1, .36, 1),
            color .42s cubic-bezier(.4, 0, .2, 1);
    }

    .reading-flight.is-visible {
        opacity: .92;
        pointer-events: auto;
        transform: translate(0, -50%);
    }

    .reading-flight:hover,
    .reading-flight.is-returning {
        color: var(--color-flight-wing-hover);
        opacity: 1;
    }

    .reading-flight:active {
        transform: translate(0, -50%) scale(.97);
    }

    :global(html[data-input-mode="keyboard"])
        .reading-flight:focus-visible {
        outline: 1px solid currentColor;
        outline-offset: 1px;
        border-radius: 1.1rem;
        opacity: 1;
    }

    .reading-flight-route {
        position: absolute;
        top: .5rem;
        left: 50%;
        width: 1px;
        height: calc(100% - 1rem);
        overflow: hidden;
        border-radius: .3rem;
        background: rgb(var(--flight-rgb) / 40%);
        transform: translateX(-50%);
    }

    .reading-flight-trail {
        position: absolute;
        top: 0;
        left: 50%;
        z-index: 1;
        width: 100%;
        height: 100%;
        background: rgb(var(--flight-rgb) / 60%);
        border-radius: 1px;
        transform: translateX(-50%) scaleY(var(--reading-progress));
        transform-origin: top;
        transition: transform .08s cubic-bezier(.22, 1, .36, 1);
    }

    .reading-flight-aircraft {
        position: absolute;
        top: 0;
        left: 50%;
        display: block;
        width: 2.08rem;
        height: 2.3rem;
        pointer-events: none;
        transform: translate(-50%, -50%) translateY(var(--reading-plane-y, .55rem));
        transform-origin: center;
        transition: transform .08s cubic-bezier(.22, 1, .36, 1);
    }

    .reading-flight-aircraft-body {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        transform-origin: center;
        transition: transform .42s cubic-bezier(.4, 0, .2, 1);
    }

    .reading-flight-plane {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        fill: currentColor;
    }

    .reading-flight-plane-wing-far {
        fill: var(--color-flight-wing-far);
    }

    .reading-flight-plane-flap {
        fill: var(--color-flight-fold);
        opacity: .18;
    }

    .reading-flight-plane-flap-far {
        opacity: .1;
    }

    .reading-flight-plane-fold,
    .reading-flight-plane-edge {
        fill: none;
        stroke: var(--color-flight-fold);
        stroke-opacity: .7;
        stroke-linecap: round;
        stroke-width: .72;
    }

    .reading-flight-plane-edge {
        opacity: .48;
        stroke-width: .56;
    }

    .reading-flight-exhaust {
        position: absolute;
        bottom: calc(100% - .35rem);
        left: 50%;
        height: .94rem;
        display: grid;
        grid-template-columns: repeat(3, 1.5px);
        gap: 3px;
        transform: translateX(-50%);
        transform-origin: bottom;
        transition: transform .25s cubic-bezier(.22, 1, .36, 1);
    }

    .reading-flight-exhaust i {
        display: block;
        height: 100%;
        border-radius: 1px;
        background: rgb(var(--flight-rgb) / 66%);
        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent,
            rgb(0 0 0 / 70%) 30%,
            #000 65%
        );
        mask-image: linear-gradient(
            to bottom,
            transparent,
            rgb(0 0 0 / 70%) 30%,
            #000 65%
        );
    }

    .reading-flight-exhaust i:nth-child(2) {
        background: rgb(var(--flight-rgb) / 90%);
        transform: scaleY(1.08);
        transform-origin: bottom;
    }

    .reading-flight-headlights {
        --flight-rgb: var(--rgb-flight-light);
        position: absolute;
        top: calc(100% - .26rem);
        left: 50%;
        height: .34rem;
        display: grid;
        grid-template-columns: repeat(2, 1.5px);
        gap: 5.75px;
        filter:
            drop-shadow(0 0 1px rgb(var(--rgb-white) / 36%))
            drop-shadow(0 1px 2px rgb(var(--flight-rgb) / 30%));
        transform: translateX(-50%);
    }

    .reading-flight-headlights i {
        position: relative;
        display: block;
        height: 100%;
        border-radius: 1px;
        background: linear-gradient(
            to bottom,
            rgb(var(--flight-rgb) / 96%),
            rgb(var(--flight-rgb) / 72%) 42%,
            transparent
        );
    }

    .reading-flight-headlights i::before {
        position: absolute;
        top: -1.5px;
        left: 50%;
        width: 2.75px;
        height: 2.75px;
        border-radius: 50%;
        background: var(--color-flight-light);
        box-shadow:
            0 0 0 1px rgb(var(--flight-rgb) / 20%),
            0 0 3px rgb(var(--flight-rgb) / 42%);
        content: "";
        transform: translateX(-50%);
    }

    @media (hover: hover) {
        .reading-flight:hover .reading-flight-aircraft-body {
            transform: rotate(180deg);
        }

        .reading-flight:hover .reading-flight-exhaust {
            transform: translateX(-50%) scaleY(1.08);
        }
    }

    .reading-flight.is-returning .reading-flight-aircraft-body {
        transform: rotate(180deg);
    }

    :global(html[data-input-mode="keyboard"])
        .reading-flight:focus-visible .reading-flight-aircraft-body {
        transform: rotate(180deg);
    }

    .reading-flight.is-returning .reading-flight-aircraft,
    .reading-flight.is-returning .reading-flight-trail {
        transition: none;
    }

    @media (hover: none) {
        .reading-flight:active .reading-flight-aircraft-body {
            transform: rotate(180deg);
        }

        .reading-flight:active .reading-flight-exhaust {
            transform: translateX(-50%) scaleY(1.08);
        }
    }

    @media screen and (max-width: 487px) {
        .reading-flight {
            right: 0;
            width: 2.75rem;
            height: var(--edge-control-length);
        }

        .reading-flight-plane {
            width: 100%;
            height: 100%;
        }

        .reading-flight-aircraft {
            width: 1.82rem;
            height: 2.02rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reading-flight,
        .reading-flight-trail,
        .reading-flight-aircraft,
        .reading-flight-aircraft-body,
        .reading-flight-exhaust {
            transition: none;
        }
    }
</style>

<script>
    const readingFlight = document.querySelector<HTMLButtonElement>("[data-reading-flight]");
    const flightRoute = readingFlight?.querySelector<HTMLElement>(".reading-flight-route");
    const aircraftBody = readingFlight?.querySelector<HTMLElement>(".reading-flight-aircraft-body");
    const scrollContainer = document.querySelector<HTMLElement>(".main");
    const articleContent = document.querySelector<HTMLElement>(".article-container.doc .article-content");

    if (readingFlight && flightRoute && aircraftBody && scrollContainer && articleContent) {
        let animationFrame = 0;
        let returnFrame = 0;
        let returnRun = 0;
        let returnProgress: number | null = null;
        let currentProgress = 0;

        const updateReadingFlight = () => {
            animationFrame = 0;
            const containerRect = scrollContainer.getBoundingClientRect();
            const contentRect = articleContent.getBoundingClientRect();
            const contentStart = scrollContainer.scrollTop + contentRect.top - containerRect.top;
            const readingDistance = Math.max(1, articleContent.offsetHeight - scrollContainer.clientHeight);
            currentProgress = returnProgress ?? Math.min(1, Math.max(0,
                (scrollContainer.scrollTop - contentStart) / readingDistance,
            ));
            readingFlight.style.setProperty("--reading-progress", String(currentProgress));
            readingFlight.style.setProperty("--reading-plane-y",
                `${flightRoute.offsetTop + currentProgress * flightRoute.offsetHeight}px`,
            );
            const visible = scrollContainer.scrollHeight > scrollContainer.clientHeight &&
                (scrollContainer.scrollTop > 48 || returnProgress !== null);
            readingFlight.classList.toggle("is-visible", visible);
            readingFlight.tabIndex = visible ? 0 : -1;
            readingFlight.setAttribute("aria-label", `阅读进度 ${Math.round(currentProgress * 100)}%，点击飞回篇首`);
        };

        const requestFlightUpdate = () => {
            if (!animationFrame) animationFrame = requestAnimationFrame(updateReadingFlight);
        };

        const cancelReturn = () => {
            returnRun++;
            cancelAnimationFrame(returnFrame);
            returnFrame = 0;
            returnProgress = null;
            readingFlight.classList.remove("is-returning");
            requestFlightUpdate();
        };

        readingFlight.addEventListener("click", async () => {
            if (returnProgress !== null) return;
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                scrollContainer.scrollTo({ top: 0, behavior: "instant" });
                requestFlightUpdate();
                return;
            }
            const startScroll = scrollContainer.scrollTop;
            const startProgress = currentProgress;
            const run = ++returnRun;
            returnProgress = startProgress;
            readingFlight.classList.add("is-returning");

            // 接续尚未完成的悬停转向；已朝上时直接返航，避免固定等待造成停顿。
            await Promise.all(aircraftBody.getAnimations().map(animation =>
                animation.finished.catch(() => undefined),
            ));
            if (run !== returnRun) return;
            const startedAt = performance.now();
            const flyHome = (now: number) => {
                const fraction = Math.min(1, Math.max(0, (now - startedAt) / 680));
                const eased = fraction ** 3 * (10 - 15 * fraction + 6 * fraction ** 2);
                const remaining = 1 - eased;
                returnProgress = startProgress * remaining;
                scrollContainer.scrollTo({ top: startScroll * remaining, behavior: "instant" });
                requestFlightUpdate();
                if (fraction < 1) returnFrame = requestAnimationFrame(flyHome);
                else cancelReturn();
            };
            returnFrame = requestAnimationFrame(flyHome);
        });

        scrollContainer.addEventListener("scroll", requestFlightUpdate, { passive: true });
        scrollContainer.addEventListener("wheel", cancelReturn, { passive: true });
        scrollContainer.addEventListener("touchstart", cancelReturn, { passive: true });
        document.addEventListener("keydown", (event) => {
            if (["Escape", "ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "].includes(event.key)) cancelReturn();
        });
        window.addEventListener("resize", requestFlightUpdate);
        window.addEventListener("load", requestFlightUpdate);
        const resizeObserver = new ResizeObserver(requestFlightUpdate);
        resizeObserver.observe(scrollContainer);
        resizeObserver.observe(articleContent);
        updateReadingFlight();
    }
</script>
