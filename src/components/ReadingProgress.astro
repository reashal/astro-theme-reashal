<button
    type="button"
    class="reading-flight"
    aria-label="阅读进度 0%，点击飞回篇首"
    title="飞回篇首"
    data-reading-flight
>
    <span class="reading-flight-route" aria-hidden="true">
        <span class="reading-flight-trail" data-reading-flight-trail></span>
    </span>
    <span
        class="reading-flight-aircraft"
        data-reading-flight-plane
        aria-hidden="true"
    >
        <span class="reading-flight-exhaust">
            <i></i>
            <i></i>
            <i></i>
        </span>
        <svg
            class="reading-flight-plane"
            viewBox="0 0 36 40"
            focusable="false"
        >
            <path
                class="reading-flight-plane-wing"
                d="M17.58 36.84c-.25.48-.94.43-1.12-.08L2.74 6.22c-.4-.9.14-1.48 1.08-1.18l13.3 3.38c.52.13.88.6.88 1.14v25.88c0 .49-.14.97-.42 1.4Z"
            ></path>
            <path
                class="reading-flight-plane-wing reading-flight-plane-wing-far"
                d="M18.42 36.84c.25.48.94.43 1.12-.08L33.26 6.22c.4-.9-.14-1.48-1.08-1.18l-13.3 3.38c-.52.13-.88.6-.88 1.14v25.88c0 .49.14.97.42 1.4Z"
            ></path>
            <path
                class="reading-flight-plane-flap"
                d="M18 9.18 11.92 23.56 18 20.88Z"
            ></path>
            <path
                class="reading-flight-plane-flap reading-flight-plane-flap-far"
                d="M18 9.18 24.08 23.56 18 20.88Z"
            ></path>
            <path
                class="reading-flight-plane-fold"
                d="M18 9.28v25.86"
            ></path>
            <path
                class="reading-flight-plane-edge"
                d="m3.82 5.58 13.3 3.46M32.18 5.58l-13.3 3.46"
            ></path>
        </svg>
        <span class="reading-flight-headlights">
            <i></i>
            <i></i>
        </span>
    </span>
</button>

<style>
    .reading-flight {
        --reading-progress: 0%;
        --flight-rgb: var(--rgb-brand);

        position: fixed;
        top: 50%;
        right: .18rem;
        z-index: 998;
        width: 2.9rem;
        height: 5.35rem;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--color-flight-wing);
        cursor: pointer;
        opacity: 0;
        pointer-events: none;
        transform: translate(.65rem, -50%);
        transition:
            opacity .25s ease,
            transform .25s ease,
            color .2s ease;
    }

    .reading-flight.is-visible {
        opacity: .82;
        pointer-events: auto;
        transform: translate(0, -50%);
    }

    .reading-flight:hover,
    .reading-flight.is-returning {
        color: var(--color-flight-wing-hover);
        opacity: 1;
        transform: translate(-.12rem, -50%);
    }

    .reading-flight:active {
        transform: translate(0, -50%) scale(.97);
    }

    :global(html[data-input-mode="keyboard"])
        .reading-flight:focus-visible {
        outline: 1px solid currentColor;
        outline-offset: 1px;
        border-radius: 1.1rem;
        opacity: 1;
    }

    .reading-flight-route {
        position: absolute;
        top: calc((100% - var(--edge-control-length)) / 2);
        left: 50%;
        width: .48rem;
        height: var(--edge-control-length);
        overflow: hidden;
        border-radius: .3rem;
        background: radial-gradient(
            ellipse at center,
            rgb(var(--flight-rgb) / 8%) 0,
            transparent 72%
        );
        transform: translateX(-50%);
    }

    .reading-flight-route::after {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 1px;
        background: repeating-linear-gradient(
            to bottom,
            rgb(var(--flight-rgb) / 24%) 0 2px,
            transparent 2px 6px
        );
        content: "";
        transform: translateX(-50%);
    }

    .reading-flight-trail {
        position: absolute;
        top: 0;
        left: 50%;
        z-index: 1;
        width: 2px;
        height: var(--reading-progress);
        background: linear-gradient(
            to bottom,
            rgb(var(--flight-rgb) / 18%),
            rgb(var(--flight-rgb) / 62%)
        );
        border-radius: 1px;
        box-shadow: 0 0 5px rgb(var(--flight-rgb) / 24%);
        transform: translateX(-50%);
        transition: height .08s linear;
    }

    .reading-flight-aircraft {
        position: absolute;
        top: .55rem;
        left: 50%;
        display: block;
        width: 2.08rem;
        height: 2.3rem;
        pointer-events: none;
        transform: translate(-50%, -50%);
        transform-origin: center;
        transition:
            top .08s linear,
            transform .34s cubic-bezier(.2, .78, .25, 1);
    }

    .reading-flight-plane {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        fill: currentColor;
        filter:
            drop-shadow(0 1px 1px rgb(var(--rgb-white) / 72%))
            drop-shadow(0 2px 3px rgb(var(--flight-rgb) / 18%));
    }

    .reading-flight-plane-wing-far {
        fill: var(--color-flight-wing-far);
    }

    .reading-flight-plane-flap {
        fill: var(--color-flight-fold);
        opacity: .28;
    }

    .reading-flight-plane-flap-far {
        opacity: .16;
    }

    .reading-flight-plane-fold,
    .reading-flight-plane-edge {
        fill: none;
        stroke: var(--color-flight-fold);
        stroke-linecap: round;
        stroke-width: .72;
    }

    .reading-flight-plane-edge {
        opacity: .48;
        stroke-width: .56;
    }

    .reading-flight-exhaust {
        position: absolute;
        bottom: calc(100% - .35rem);
        left: 50%;
        height: .94rem;
        display: grid;
        grid-template-columns: repeat(3, 1.2px);
        gap: 3px;
        filter: drop-shadow(0 0 2px rgb(var(--flight-rgb) / 25%));
        transform: translateX(-50%);
        transform-origin: bottom;
        transition: transform .25s ease;
    }

    .reading-flight-exhaust i {
        display: block;
        height: 100%;
        border-radius: 1px;
        background: rgb(var(--flight-rgb) / 62%);
        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent,
            rgb(0 0 0 / 36%) 24%,
            #000
        );
        mask-image: linear-gradient(
            to bottom,
            transparent,
            rgb(0 0 0 / 36%) 24%,
            #000
        );
    }

    .reading-flight-exhaust i:nth-child(2) {
        background: rgb(var(--flight-rgb) / 82%);
        transform: scaleY(1.08);
        transform-origin: bottom;
    }

    .reading-flight-headlights {
        position: absolute;
        top: calc(100% - .26rem);
        left: 50%;
        height: .34rem;
        display: grid;
        grid-template-columns: repeat(2, 1.5px);
        gap: 5.75px;
        filter:
            drop-shadow(0 0 1px rgb(var(--rgb-white) / 78%))
            drop-shadow(0 1px 3px rgb(var(--flight-rgb) / 62%));
        transform: translateX(-50%);
    }

    .reading-flight-headlights i {
        position: relative;
        display: block;
        height: 100%;
        border-radius: 1px;
        background: linear-gradient(
            to bottom,
            rgb(var(--flight-rgb) / 96%),
            rgb(var(--flight-rgb) / 72%) 42%,
            transparent
        );
    }

    .reading-flight-headlights i::before {
        position: absolute;
        top: -1.5px;
        left: 50%;
        width: 2.75px;
        height: 2.75px;
        border-radius: 50%;
        background: var(--color-flight-fold);
        box-shadow:
            0 0 0 1px rgb(var(--flight-rgb) / 28%),
            0 0 4px rgb(var(--flight-rgb) / 72%);
        content: "";
        transform: translateX(-50%);
    }

    .reading-flight:hover .reading-flight-aircraft {
        transform: translate(-50%, -50%) rotate(180deg) scale(1.035);
    }

    .reading-flight:hover .reading-flight-exhaust {
        transform: translateX(-50%) scaleY(1.08);
    }

    .reading-flight.is-returning .reading-flight-aircraft {
        transform: translate(-50%, -50%) rotate(180deg);
    }

    :global(.dark) .reading-flight {
        --flight-rgb: var(--rgb-accent-cyan);
    }

    :global(.dark) .reading-flight-plane {
        filter:
            drop-shadow(0 1px 1px rgb(var(--rgb-black) / 44%))
            drop-shadow(0 2px 4px rgb(var(--rgb-black) / 58%));
    }

    @media screen and (max-width: 487px) {
        .reading-flight {
            right: 0;
            width: 2.75rem;
            height: 4.9rem;
        }

        .reading-flight-plane {
            width: 100%;
            height: 100%;
        }

        .reading-flight-aircraft {
            width: 1.82rem;
            height: 2.02rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .reading-flight,
        .reading-flight-trail,
        .reading-flight-aircraft,
        .reading-flight-exhaust {
            transition: none;
        }
    }
</style>

<script>
    const readingFlight = document.querySelector<HTMLButtonElement>(
        "[data-reading-flight]",
    );
    const flightTrail = document.querySelector<HTMLElement>(
        "[data-reading-flight-trail]",
    );
    const flightRoute = flightTrail?.parentElement;
    const flightPlane = document.querySelector<HTMLElement>(
        "[data-reading-flight-plane]",
    );
    const scrollContainer = document.querySelector<HTMLElement>(".main");
    const articleContent = document.querySelector<HTMLElement>(
        ".article-container.doc .article-content",
    );

    if (
        readingFlight &&
        flightRoute &&
        flightTrail &&
        flightPlane &&
        scrollContainer &&
        articleContent
    ) {
        let animationFrame = 0;

        const updateReadingFlight = () => {
            animationFrame = 0;
            const containerRect = scrollContainer.getBoundingClientRect();
            const contentRect = articleContent.getBoundingClientRect();
            const contentStart =
                scrollContainer.scrollTop +
                contentRect.top -
                containerRect.top;
            const contentEnd = contentStart + articleContent.offsetHeight;
            const readingDistance = Math.max(
                1,
                contentEnd - scrollContainer.clientHeight - contentStart,
            );
            const progress =
                Math.min(
                    100,
                    Math.max(
                        0,
                        ((scrollContainer.scrollTop - contentStart) /
                            readingDistance) *
                            100,
                    ),
                );
            const roundedProgress = Math.round(progress);

            readingFlight.style.setProperty(
                "--reading-progress",
                `${progress}%`,
            );
            flightPlane.style.top = `${
                flightRoute.offsetTop +
                (progress / 100) * flightRoute.offsetHeight
            }px`;
            readingFlight.classList.toggle(
                "is-visible",
                scrollContainer.scrollHeight > scrollContainer.clientHeight &&
                    scrollContainer.scrollTop > 48,
            );
            if (scrollContainer.scrollTop <= 1) {
                readingFlight.classList.remove("is-returning");
            }
            readingFlight.setAttribute(
                "aria-label",
                `阅读进度 ${roundedProgress}%，点击飞回篇首`,
            );
        };

        const requestFlightUpdate = () => {
            if (animationFrame) return;
            animationFrame = requestAnimationFrame(updateReadingFlight);
        };

        readingFlight.addEventListener("click", () => {
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            readingFlight.classList.add("is-returning");
            readingFlight.blur();
            scrollContainer.scrollTo({
                top: 0,
                behavior: reduceMotion ? "auto" : "smooth",
            });
        });

        scrollContainer.addEventListener("scroll", requestFlightUpdate, {
            passive: true,
        });
        window.addEventListener("resize", requestFlightUpdate);
        window.addEventListener("load", requestFlightUpdate);

        const resizeObserver = new ResizeObserver(requestFlightUpdate);
        resizeObserver.observe(scrollContainer);
        resizeObserver.observe(articleContent);

        updateReadingFlight();
    }
</script>
