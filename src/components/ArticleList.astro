---
import { SITE_INFO } from "../consts";
import type { ArticleModule } from "../types";
import "../styles/docs.css";

interface Props {
    articles: ArticleModule[];
    editorial?: boolean;
}

const { articles, editorial = false } = Astro.props as Props;
---

<article class:list={["article-container docs", { "docs-editorial": editorial }]} id="docs-container">
    <div class="docs-content">
    <div class="docs-list">
    {articles.map((post) => {
        const isPinned = post.frontmatter.pinned === true;
        return (
            <a
                href={post.url}
                class:list={["docs-body docs-a", { "docs-fixed": isPinned }]}
            >
                <h2 class="docs-h">
                    {post.frontmatter.title}
                    {editorial && isPinned && (
                        <svg class="docs-pin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="置顶文章">
                            <title>置顶文章</title>
                            <g transform="rotate(32 12 12)">
                                <path d="M8 4h8v2l-1 1v4l3 3v2H6v-2l3-3V7L8 6Z" fill="currentColor" fill-opacity=".12" />
                                <path d="M12 16v5M9 7h6" />
                            </g>
                        </svg>
                    )}
                </h2>
                <p class="docs-p">{post.frontmatter.desc}</p>
                <time
                    class="docs-t"
                    datetime={post.frontmatter.pubDate}
                >
                    {post.frontmatter.pubDate}
                </time>
            </a>
        );
    })}
    </div>
    
    {articles.length === 0 && (
        <div class="docs-body docs-empty">
            <p class="docs-p">暂无文章</p>
        </div>
    )}

    <footer class="docs-footer" id="docs-footer">
        <nav class="docs-pagination" id="docs-pagination" aria-label="分页导航">
        </nav>
        <p class="end-tip" id="docs-end-tip">{SITE_INFO.endTip}</p>
    </footer>
    </div>
    <script>
        (function () {
            const container = document.getElementById("docs-container")!;
            const pagination = document.getElementById("docs-pagination")!;
            const endTip = document.getElementById("docs-end-tip")!;
            const list = container.querySelector<HTMLElement>(".docs-list")!;
            const content = container.querySelector<HTMLElement>(".docs-content")!;
            const mainEl = document.querySelector<HTMLElement>(".main");
            const isEditorial = container.classList.contains("docs-editorial");
            const allItems = Array.from(
                container.querySelectorAll<HTMLElement>(".docs-a"),
            );
            if (allItems.length === 0) return;

            const MIN_END_TIP_SPACE = 100;
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            );
            let currentPage = 0;
            let perPage = 1;
            let hasEntered = false;
            let requestedPage = 0;
            let transitionVersion = 0;
            let pageAnimation: Animation | null = null;
            type HistoryMode = "none" | "push" | "replace";

            function calcPerPage(): number {
                const rootStyle = getComputedStyle(document.documentElement);
                return parseInt(rootStyle.getPropertyValue("--per-page")) || 1;
            }

            function totalPages(): number {
                if (perPage <= 0) return 0;
                return Math.ceil(allItems.length / perPage);
            }

            function pageFromUrl(): number {
                const value = Number(
                    new URL(window.location.href).searchParams.get("page"),
                );
                return Number.isInteger(value) && value > 0 ? value - 1 : 0;
            }

            function syncPageUrl(mode: Exclude<HistoryMode, "none">): void {
                const url = new URL(window.location.href);
                if (currentPage === 0) {
                    url.searchParams.delete("page");
                } else {
                    url.searchParams.set("page", String(currentPage + 1));
                }
                window.history[
                    mode === "push" ? "pushState" : "replaceState"
                ](null, "", `${url.pathname}${url.search}${url.hash}`);
            }

            function hasRoomForEndTip(): boolean {
                const footerEl = document.getElementById("docs-footer") as HTMLElement | null;
                if (!footerEl) return false;
                if (isEditorial) {
                    return footerEl.getBoundingClientRect().top -
                        list.getBoundingClientRect().bottom > MIN_END_TIP_SPACE;
                }
                const articleStyle = getComputedStyle(container);
                const contentStyle = getComputedStyle(content);
                // 使用实际边界，兼容标题与摘要换行后的行高。
                const available = container.getBoundingClientRect().bottom -
                    parseFloat(articleStyle.paddingBottom) -
                    parseFloat(contentStyle.paddingBottom) -
                    footerEl.getBoundingClientRect().bottom;
                return available > MIN_END_TIP_SPACE;
            }

            function revealEntries(): void {
                if (!isEditorial || reduceMotion.matches) return;
                const animation = content.animate([
                    { opacity: 0, transform: "translateY(4px)" },
                    { opacity: 1, transform: "translateY(0)" },
                ], {
                    duration: 220,
                    easing: "cubic-bezier(.16, 1, .3, 1)",
                    fill: "both",
                });
                pageAnimation = animation;
                void animation.finished.then(() => {
                    if (pageAnimation !== animation) return;
                    animation.cancel();
                    pageAnimation = null;
                }, () => {});
            }

            function cancelPageTransition(): void {
                transitionVersion++;
                pageAnimation?.cancel();
                pageAnimation = null;
                content.removeAttribute("aria-busy");
            }

            async function changePage(page: number, historyMode: HistoryMode = "push"): Promise<void> {
                const nextPage = Math.max(0, Math.min(page, totalPages() - 1));
                if (nextPage === requestedPage) return;
                requestedPage = nextPage;

                // 从正在显示的状态接续，快速连点不会先闪回完全不透明。
                const style = getComputedStyle(content);
                const from = { opacity: style.opacity, transform: style.transform };
                cancelPageTransition();
                const version = transitionVersion;

                if (isEditorial && hasEntered && !reduceMotion.matches) {
                    content.setAttribute("aria-busy", "true");
                    const exit = content.animate([
                        from,
                        { opacity: 0, transform: "translateY(-4px)" },
                    ], {
                        duration: 100,
                        easing: "cubic-bezier(.4, 0, 1, 1)",
                        fill: "forwards",
                    });
                    pageAnimation = exit;
                    try {
                        await exit.finished;
                    } catch {
                        return;
                    }
                    if (version !== transitionVersion) return;
                }

                const listTop = mainEl
                    ? mainEl.scrollTop + container.getBoundingClientRect().top -
                        Math.max(0, mainEl.getBoundingClientRect().top) + parseFloat(getComputedStyle(container).paddingTop) - 16
                    : 0;
                const scrollTop = Math.min(mainEl?.scrollTop ?? 0, Math.max(0, listTop));
                showPage(nextPage, nextPage === currentPage && historyMode === "push" ? "none" : historyMode);
                scrollToPageStart(scrollTop);
                pageAnimation?.cancel();
                pageAnimation = null;
                content.removeAttribute("aria-busy");
                revealEntries();
            }

            function scrollToPageStart(top: number): void {
                if (!mainEl) return;
                if (isEditorial) {
                    mainEl.scrollTo({ top, behavior: "instant" });
                } else {
                    mainEl.scrollTo({ top: 0, behavior: reduceMotion.matches ? "instant" : "smooth" });
                }
            }

            function retainPaginationFocus(label: string | null): void {
                if (!label) return;
                const buttons = Array.from(pagination.querySelectorAll<HTMLButtonElement>("button"));
                const target = buttons.find((button) => button.getAttribute("aria-label") === label && !button.disabled) ??
                    buttons.find((button) => button.getAttribute("aria-current") === "page");
                target?.focus({ preventScroll: true });
            }

            function showPage(
                page: number,
                historyMode: HistoryMode = "none",
            ): void {
                currentPage = Math.max(0, Math.min(page, totalPages() - 1));
                requestedPage = currentPage;
                const start = currentPage * perPage;
                const end = start + perPage;
                const lastVisibleIndex = Math.min(end, allItems.length) - 1;

                allItems.forEach((item, i) => {
                    const isVisible = i >= start && i < end;
                    item.hidden = !isVisible;
                    item.classList.toggle(
                        "docs-last",
                        isVisible && i === lastVisibleIndex,
                    );
                });

                const focusedLabel = pagination.contains(document.activeElement)
                    ? document.activeElement?.getAttribute("aria-label") ?? null
                    : null;
                renderPagination();
                retainPaginationFocus(focusedLabel);
                if (historyMode !== "none") {
                    syncPageUrl(historyMode);
                }

                endTip.hidden = true;
                if (totalPages() === 1) {
                    endTip.hidden = !hasRoomForEndTip();
                }
            }

            function renderPagination(): void {
                const total = totalPages();
                if (total <= 1) {
                    pagination.style.display = "none";
                    return;
                }
                pagination.style.display = "";

                const pages: (number | string)[] = [];
                if (total <= 7) {
                    for (let i = 0; i < total; i++) pages.push(i);
                } else {
                    pages.push(0);
                    const lo = Math.max(1, currentPage - 1);
                    const hi = Math.min(total - 2, currentPage + 1);
                    if (lo > 1) pages.push("…");
                    for (let i = lo; i <= hi; i++) pages.push(i);
                    if (hi < total - 2) pages.push("…");
                    pages.push(total - 1);
                }

                pagination.innerHTML = "";

                const prev = document.createElement("button");
                prev.type = "button";
                prev.className = "page-btn page-prev";
                prev.textContent = "‹";
                prev.setAttribute("aria-label", "上一页");
                prev.disabled = currentPage === 0;
                prev.addEventListener("click", () => {
                    void changePage(requestedPage - 1);
                });
                pagination.appendChild(prev);

                pages.forEach((p) => {
                    if (p === "…") {
                        const sep = document.createElement("span");
                        sep.className = "page-sep";
                        sep.textContent = "…";
                        sep.setAttribute("aria-hidden", "true");
                        pagination.appendChild(sep);
                    } else {
                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className =
                            "page-btn" +
                            (p === currentPage ? " page-active" : "");
                        btn.textContent = String(Number(p) + 1);
                        btn.setAttribute(
                            "aria-label",
                            `第 ${Number(p) + 1} 页`,
                        );
                        if (p === currentPage) {
                            btn.setAttribute("aria-current", "page");
                        }
                        btn.addEventListener("click", () => {
                            void changePage(Number(p));
                        });
                        pagination.appendChild(btn);
                    }
                });

                const next = document.createElement("button");
                next.type = "button";
                next.className = "page-btn page-next";
                next.textContent = "›";
                next.setAttribute("aria-label", "下一页");
                next.disabled = currentPage === totalPages() - 1;
                next.addEventListener("click", () => {
                    void changePage(requestedPage + 1);
                });
                pagination.appendChild(next);
            }

            function init(): void {
                perPage = calcPerPage();
                showPage(pageFromUrl(), "replace");
                if (document.fonts?.ready) {
                    void document.fonts.ready.then(() => {
                        if (totalPages() !== 1) return;
                        endTip.hidden = !hasRoomForEndTip();
                    });
                }
            }

            init();

            if (isEditorial) {
                const observer = new IntersectionObserver((entries) => {
                    if (!entries.some((entry) => entry.isIntersecting)) return;
                    hasEntered = true;
                    if (!pageAnimation) revealEntries();
                    observer.disconnect();
                }, { root: document.querySelector(".main"), threshold: .05 });
                observer.observe(list);
            }

            let resizeTimer: number;
            window.addEventListener("resize", () => {
                clearTimeout(resizeTimer);
                resizeTimer = window.setTimeout(() => {
                    cancelPageTransition();
                    const firstVisibleIndex = currentPage * perPage;
                    perPage = calcPerPage();
                    showPage(
                        Math.floor(firstVisibleIndex / perPage),
                        "replace",
                    );
                }, 150);
            });

            window.addEventListener("popstate", () => {
                void changePage(pageFromUrl(), "none");
            });

            reduceMotion.addEventListener("change", () => {
                if (reduceMotion.matches) pageAnimation?.finish();
            });
        })();
    </script>
</article>
