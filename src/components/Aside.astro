---
import "../styles/aside.css";
import { AUTHOR_INFO } from "../consts";
import { pagesConfig } from "../utils/pages";
import GetTags from "./GetTags.astro";

const navLinks = pagesConfig
    .filter(page => !page.hiddenInAside)
    .map(page => ({
        label: page.title,
        description: page.description,
        href: page.path,
        icon: page.icon,
        external: page.type === 'external'
    }));

const navGroups = [
    {
        label: "站内导航",
        className: "aside-links-primary",
        links: navLinks.filter((link) => !link.external),
    },
    {
        label: "站外链接",
        className: "aside-links-external",
        links: navLinks.filter((link) => link.external),
    },
];

const currentPath = Astro.url.pathname;
---

<aside aria-label="站点侧边栏">
    <section id="aside-content" class="aside-body" aria-hidden="true" inert>
        <a
            class="aside-author-card"
            href="/about"
            aria-labelledby="aside-author-name"
            aria-describedby="aside-author-desc"
            aria-current={
                currentPath === "/about" || currentPath.startsWith("/about/")
                    ? "page"
                    : undefined
            }
        >
            <img
                class="author-avatar"
                src={AUTHOR_INFO.avatar}
                alt={AUTHOR_INFO.name}
                title={AUTHOR_INFO.name}
                loading="lazy"
                decoding="async"
            />
            <div class="author-info">
                <h3 class="author-name" id="aside-author-name">
                    {AUTHOR_INFO.name}
                </h3>
                <p class="author-desc" id="aside-author-desc">
                    {AUTHOR_INFO.description}
                </p>
            </div>
        </a>

        <nav class="aside-links-card" aria-label="站点导航">
            {
                navGroups.map((group) =>
                    group.links.length > 0 && (
                        <div
                            class={group.className}
                            role="group"
                            aria-label={group.label}
                        >
                            {group.links.map((link) => {
                                const isActive =
                                    currentPath === link.href ||
                                    (link.href !== "/" &&
                                        currentPath.startsWith(`${link.href}/`));
                                return (
                                    <a
                                        href={link.href}
                                        target={link.external ? "_blank" : undefined}
                                        rel={link.external ? "noopener noreferrer" : undefined}
                                        class={`${link.icon} ${isActive ? "active" : ""}`}
                                        aria-current={isActive ? "page" : undefined}
                                        title={link.description}
                                    >
                                        <span>{link.label}</span>
                                    </a>
                                );
                            })}
                        </div>
                    ),
                )
            }
        </nav>

        <section class="aside-share-card">
            <button type="button" class="share-link" id="aside-share-btn">
                <i class="iconfont icon-share"></i>
                分享当前页面
            </button>
        </section>

        <GetTags />

        <section class="aside-copyright-card">
            <div>
                Powered By <a href="//astro.build" class="copy-a" target="_blank"
                    >Astro</a
                >
            </div>
            <div>
                Themed By <a href="/about" class="copy-a"
                    >reashal</a
                >
            </div>
        </section>
    </section>

    <button
        type="button"
        class="aside-toggle-btn"
        aria-label="展开侧边栏"
        aria-expanded="false"
        aria-controls="aside-content"
    >
        <span class="aside-toggle-mark" aria-hidden="true"><i></i><i></i></span>
    </button>
</aside>

<script>
    const layout = document.querySelector<HTMLElement>("main");
    const mainContent = layout?.querySelector<HTMLElement>(".main");
    const asideBody = document.querySelector<HTMLElement>(".aside-body");
    const asideToggle =
        document.querySelector<HTMLButtonElement>(".aside-toggle-btn");
    const asideShareBtn = document.getElementById("aside-share-btn");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const sidebar = asideBody?.closest("aside");
    let motionFrame = 0;
    let motion: { from: number; velocity: number; target: number; started: number; frequency: number } | null = null;
    let afterMotion: (() => void) | null = null;

    // Move the scroll viewport itself so its clipping edge stays with the sidebar.
    // Fixed reading tools live outside these surfaces in BaseLayout.
    const surfaces = [sidebar, mainContent].filter((element): element is HTMLElement => !!element);

    function sampleMotion(now: number) {
        if (!motion) return { position: sidebar?.getBoundingClientRect().left ?? 0, velocity: 0 };
        const t = Math.max(0, (now - motion.started) / 1000);
        const displacement = motion.from - motion.target;
        const coefficient = motion.velocity + motion.frequency * displacement;
        const decay = Math.exp(-motion.frequency * t);
        return {
            position: motion.target + (displacement + coefficient * t) * decay,
            velocity: (motion.velocity - motion.frequency * coefficient * t) * decay,
        };
    }

    function finishMotion() {
        cancelAnimationFrame(motionFrame);
        motionFrame = 0;
        motion = null;
        surfaces.forEach(element => {
            element.style.removeProperty("transform");
            element.style.removeProperty("will-change");
        });
        const completion = afterMotion;
        afterMotion = null;
        completion?.();
    }

    function renderMotion(now: number) {
        if (!motion) return;
        const current = sampleMotion(now);
        const offset = current.position - motion.target;
        if (Math.abs(offset) < .1 && Math.abs(current.velocity) < 1) {
            finishMotion();
            return;
        }
        // A critically damped spring preserves velocity when the target reverses.
        // Both surfaces receive exactly the same offset in the same frame.
        surfaces.forEach(element => { element.style.transform = `translateX(${offset}px)`; });
        motionFrame = requestAnimationFrame(renderMotion);
    }

    window.addEventListener("resize", finishMotion);
    window.addEventListener("pagehide", finishMotion);
    reducedMotion.addEventListener("change", finishMotion);

    function syncAsideAccessibility(isOpen: boolean) {
        if (!asideBody) return;
        asideBody.inert = !isOpen;
        asideBody.setAttribute("aria-hidden", String(!isOpen));
    }

    function setAsideOpen(isOpen: boolean) {
        if (!layout) return;
        if (layout.classList.contains("aside-show") === isOpen) return;

        const now = performance.now();
        const current = sampleMotion(now);
        cancelAnimationFrame(motionFrame);

        layout.classList.remove("aside-init", "aside-show", "aside-hide");
        layout.classList.add(isOpen ? "aside-show" : "aside-hide");
        syncAsideAccessibility(isOpen);

        if (!reducedMotion.matches) {
            motion = { from: current.position, velocity: current.velocity,
                target: isOpen ? 0 : -(sidebar?.offsetWidth ?? 0), started: now,
                frequency: isOpen ? 7.5 : 9 };
            surfaces.forEach(element => { element.style.willChange = "transform"; });
            renderMotion(now);
        } else finishMotion();

        if (asideToggle) {
            asideToggle.setAttribute("aria-expanded", String(isOpen));
            asideToggle.tabIndex = isOpen ? -1 : 0;
            asideToggle.setAttribute("aria-hidden", String(isOpen));
            if (isOpen && document.activeElement === asideToggle) {
                asideBody?.querySelector<HTMLAnchorElement>(".aside-author-card")?.focus({ preventScroll: true });
            } else if (!isOpen && asideBody?.contains(document.activeElement)) {
                asideToggle.focus({ preventScroll: true });
            }
        }
    }

    asideToggle?.addEventListener("click", () => {
        setAsideOpen(!layout?.classList.contains("aside-show"));
    });

    // 展开状态点击侧边栏外部：收起侧边栏，同时拦截内容的默认行为
    // （打开大图、播放媒体、跳转链接），避免穿透触发；
    // 页面自身控件（按钮）不拦截，仍可正常使用。
    mainContent?.addEventListener(
        "click",
        (event) => {
            if (!layout?.classList.contains("aside-show")) return;

            setAsideOpen(false);

            const target = event.target as HTMLElement | null;
            const swallow =
                target &&
                target.closest(
                    "a, img, audio, video, [data-media-group], .music-toggle, [role='button']",
                );
            if (swallow) {
                event.preventDefault();
                event.stopPropagation();
            }
        },
        true,
    );

    // 评论区（Giscus iframe）内的点击不会冒泡到父文档，但会把父文档
    // 焦点移入 iframe：借此判定点击了评论等内嵌内容，并同步收起侧边栏。
    window.addEventListener(
        "blur",
        () => {
            if (
                layout?.classList.contains("aside-show") &&
                document.activeElement?.closest("iframe")
            ) {
                setAsideOpen(false);
            }
        },
        true,
    );

    document.addEventListener("keydown", (event) => {
        if (
            event.key === "Escape" &&
            layout?.classList.contains("aside-show")
        ) {
            setAsideOpen(false);
            if (asideToggle) {
                asideToggle.classList.add("is-escape-focus");
                asideToggle.focus({ preventScroll: true });
                const clearEscapeFocus = () => {
                    asideToggle.classList.remove("is-escape-focus");
                };
                asideToggle.addEventListener(
                    "blur",
                    clearEscapeFocus,
                    { once: true },
                );
                asideToggle.addEventListener(
                    "keydown",
                    clearEscapeFocus,
                    { once: true },
                );
                asideToggle.addEventListener(
                    "pointerdown",
                    clearEscapeFocus,
                    { once: true },
                );
            }
        }
    });

    if (asideShareBtn) {
        asideShareBtn.addEventListener("click", () => {
            const wasOpen = layout?.classList.contains("aside-show") ?? false;
            if (wasOpen) setAsideOpen(false);

            const share = () => { document.getElementById("share-btn")?.click(); };
            if (motion) afterMotion = share;
            else share();
        });
    }
</script>
