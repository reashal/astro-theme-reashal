---
import type { MarkdownHeading } from "astro";
import "../styles/article-toc.css";
import Search from "./Search.astro";
import Dark from "./Dark.astro";
import ReadingProgress from "./ReadingProgress.astro";

interface Props {
    headings?: MarkdownHeading[];
    pageName?: string;
    readingProgress?: boolean;
}

const { headings = [], pageName = "", readingProgress = false } = Astro.props as Props;
---

<section
    class="article-toc"
    data-article-toc
    data-page-name={pageName}
    data-has-directory={headings.length > 0 ? "true" : "false"}
    data-pagefind-ignore="all"
>
    <button
        class="article-toc-summary"
        type="button"
        aria-expanded="false"
        aria-controls="articleTocPanel"
        data-article-toc-toggle
    >
        {headings.length > 0 ? <span class="article-tools-minimap" aria-hidden="true">
            {headings.map((heading, index) => <i data-toc-tick={heading.slug} data-depth={heading.depth} class:list={{"is-current": index === 0}} hidden={index >= 9} />)}
        </span> : <svg class="article-tools-symbol" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M5 17h14M9 4v6m6 4v6" /></svg>}
        <span data-toc-summary-current>
            {headings[0]?.text || pageName}
        </span>
    </button>
    <nav
        id="articleTocPanel"
        aria-label={headings.length > 0 ? "文章目录与阅读工具" : `${pageName}页面工具`}
        hidden
    >
        {headings.length > 0 ? <a class="article-toc-panel-title" data-toc-panel-title href="#article-start">目录</a> :
            <span class="article-toc-panel-title" data-toc-panel-title>{pageName}</span>}
        {headings.length > 0 && <button class="article-toc-search-back" type="button" data-toc-search-back hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
            返回目录
        </button>}
        <Search />
        <Dark />
        {headings.length > 0 && <><div
            class="article-toc-viewport"
            data-toc-viewport
            tabindex="0"
            aria-label="左右滑动切换标题层级"
        >
            <div class="article-toc-track" data-toc-track />
        </div>
        <div class="article-toc-level-switcher">
            <button
                type="button"
                data-toc-previous
                aria-label="查看上一层标题"
            >
                <i aria-hidden="true" />
                上一层
            </button>
            <span data-toc-level-status aria-live="polite" />
            <button
                type="button"
                data-toc-next
                aria-label="返回下一层标题"
            >
                下一层
                <i aria-hidden="true" />
            </button>
        </div></>}
        <ReadingProgress article={readingProgress} />
    </nav>
    <div class="article-toc-data" hidden>
        {
            headings.map((heading) => (
                <span
                    data-toc-heading
                    data-depth={heading.depth}
                    data-slug={heading.slug}
                >
                    {heading.text}
                </span>
            ))
        }
    </div>
</section>

<script src="../scripts/article-toc.ts"></script>
