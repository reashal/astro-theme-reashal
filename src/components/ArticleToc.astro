---
import type { MarkdownHeading } from "astro";
import "../styles/article-toc.css";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props as Props;
---

<section
    class="article-toc"
    data-article-toc
    data-pagefind-ignore="all"
>
    <button
        class="article-toc-summary"
        type="button"
        aria-expanded="false"
        aria-controls="articleTocPanel"
        data-article-toc-toggle
    >
        <span data-toc-summary-current>
            {headings[0]?.text || "标题"}
        </span>
    </button>
    <nav
        id="articleTocPanel"
        aria-label="文章层级标题"
        hidden
    >
        <div
            class="article-toc-viewport"
            data-toc-viewport
            tabindex="0"
            aria-label="左右滑动切换标题层级"
        >
            <div class="article-toc-track" data-toc-track />
        </div>
        <div class="article-toc-level-switcher">
            <button
                type="button"
                data-toc-previous
                aria-label="查看上一层标题"
            >
                <i aria-hidden="true" />
                上一层
            </button>
            <span data-toc-level-status aria-live="polite" />
            <button
                type="button"
                data-toc-next
                aria-label="返回下一层标题"
            >
                下一层
                <i aria-hidden="true" />
            </button>
        </div>
    </nav>
    <div class="article-toc-data" hidden>
        {
            headings.map((heading) => (
                <span
                    data-toc-heading
                    data-depth={heading.depth}
                    data-slug={heading.slug}
                >
                    {heading.text}
                </span>
            ))
        }
    </div>
</section>

<script src="../scripts/article-toc.ts"></script>
