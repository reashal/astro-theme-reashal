---
import { getSiteContentData } from "../utils/content-data";

const { references } = await getSiteContentData();
const referenceJson = JSON.stringify(references).replaceAll("<", "\\u003c");
---

<section
    class="view-box view-box-hide"
    id="view-box"
    role="dialog"
    aria-modal="true"
    aria-label="媒体查看器"
    aria-hidden="true"
    tabindex="-1"
>
    <div class="view-topbar">
        <span class="view-counter" id="view-counter" aria-live="polite"></span>
        <button class="view-control view-close" id="view-close" type="button" aria-label="关闭媒体查看器">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
        </button>
    </div>

    <button class="view-control view-nav view-prev" id="view-prev" type="button" aria-label="上一项媒体">
        <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="m15 18-6-6 6-6"></path>
        </svg>
    </button>

    <figure class="view-content" id="view-content">
        <div class="view-stage" id="view-stage">
            <img
                src=""
                alt=""
                class="view-img"
                id="view-img"
                draggable="false"
                decoding="async"
            />
            <video
                class="view-video"
                id="view-video"
                controls
                playsinline
                preload="metadata"
                hidden
            ></video>
            <span class="view-loading" id="view-loading" aria-live="polite">正在载入媒体</span>
            <span class="view-error" id="view-error" role="status">媒体暂时无法载入</span>
        </div>
        <div class="view-details">
            <figcaption class="view-caption" id="view-caption"></figcaption>
            <section class="view-references" id="view-references" hidden aria-label="图片引用位置">
                <p id="view-references-summary"></p>
                <div id="view-references-list"></div>
            </section>
        </div>
    </figure>

    <button class="view-control view-nav view-next" id="view-next" type="button" aria-label="下一项媒体">
        <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="m9 6 6 6-6 6"></path>
        </svg>
    </button>

    <div class="view-tools" aria-label="图片缩放控制">
        <button class="view-tool" id="view-zoom-out" type="button" aria-label="缩小图片">−</button>
        <button class="view-scale" id="view-scale" type="button" aria-label="恢复原始缩放">100%</button>
        <button class="view-tool" id="view-zoom-in" type="button" aria-label="放大图片">＋</button>
    </div>
</section>

<script is:inline type="application/json" id="image-reference-data" set:html={referenceJson}></script>

<script src="../scripts/image-viewer.ts"></script>

<style is:inline>
    .view-box {
        --viewer-surface: rgb(var(--rgb-dark-message) / 82%);
        --viewer-control: rgb(var(--rgb-white) / 10%);
        --viewer-control-hover: rgb(var(--rgb-accent-cyan) / 22%);
        position: fixed;
        inset: 0;
        z-index: 999999;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        color: var(--color-white);
        background: rgb(var(--rgb-black) / 90%);
        backdrop-filter: blur(12px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        user-select: none;
        transition:
            opacity .24s ease,
            visibility .24s ease;
    }

    .view-box-show {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .view-topbar {
        position: absolute;
        top: max(1rem, env(safe-area-inset-top));
        left: 50%;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: .55rem;
        transform: translateX(-50%);
    }

    .view-counter,
    .view-control,
    .view-tools {
        border: 1px solid rgb(var(--rgb-white) / 12%);
        background: var(--viewer-surface);
        box-shadow: 0 .5rem 1.6rem rgb(var(--rgb-black) / 24%);
        backdrop-filter: blur(14px);
    }

    .view-counter {
        min-width: 3.8rem;
        padding: .42rem .72rem;
        border-radius: 999px;
        color: rgb(var(--rgb-white) / 78%);
        font-size: .78rem;
        line-height: 1;
        text-align: center;
    }

    .view-control,
    .view-tool,
    .view-scale {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: inherit;
        font: inherit;
        cursor: pointer;
    }

    .view-control {
        width: 2.55rem;
        height: 2.55rem;
        border-radius: 50%;
        transition:
            color .2s ease,
            border-color .2s ease,
            background-color .2s ease,
            transform .2s ease;
    }

    .view-control svg {
        width: 1.2rem;
        height: 1.2rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
    }

    .view-control:hover,
    html[data-input-mode="keyboard"] .view-control:focus-visible {
        color: var(--color-accent-cyan);
        border-color: rgb(var(--rgb-accent-cyan) / 42%);
        background: var(--viewer-control-hover);
        outline: none;
    }

    .view-control:active {
        transform: scale(.94);
    }

    .view-close {
        width: 2.2rem;
        height: 2.2rem;
    }

    .view-nav {
        position: absolute;
        top: 50%;
        z-index: 3;
        transform: translateY(-50%);
    }

    .view-prev {
        left: max(1rem, env(safe-area-inset-left));
    }

    .view-next {
        right: max(1rem, env(safe-area-inset-right));
    }

    .view-nav:hover,
    html[data-input-mode="keyboard"] .view-nav:focus-visible {
        transform: translateY(-50%) scale(1.06);
    }

    .view-nav:active {
        transform: translateY(-50%) scale(.94);
    }

    .view-nav[hidden],
    .view-counter[hidden],
    .view-caption:empty {
        display: none;
    }

    .view-content {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        gap: .75rem;
        width: min(84vw, 80rem);
        height: min(82vh, 52rem);
        height: min(82dvh, 52rem);
        margin: 0;
    }

    .view-stage {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        touch-action: none;
    }

    .view-img,
    .view-video {
        display: block;
        max-width: 100%;
        max-height: 100%;
        border-radius: .45rem;
        box-shadow: 0 .45rem 2rem rgb(var(--rgb-black) / 42%);
    }

    .view-img {
        transform: translate3d(0, 0, 0) scale(1);
        transform-origin: center;
        transition:
            opacity .18s ease,
            transform .16s ease;
        cursor: default;
        -webkit-user-drag: none;
    }

    .view-video {
        width: min(100%, 72rem);
        background: var(--color-black);
        outline: none;
    }

    .view-img[hidden],
    .view-video[hidden],
    .view-tools[hidden] {
        display: none;
    }

    .view-stage.is-video {
        touch-action: auto;
    }

    .view-stage.is-zoomed .view-img {
        cursor: grab;
    }

    .view-stage.is-dragging .view-img {
        cursor: grabbing;
        transition: opacity .18s ease;
    }

    .view-box.is-loading .view-img,
    .view-box.has-error .view-img,
    .view-box.is-loading .view-video,
    .view-box.has-error .view-video {
        opacity: 0;
    }

    .view-loading,
    .view-error {
        position: absolute;
        left: 50%;
        top: 50%;
        display: none;
        transform: translate(-50%, -50%);
        color: rgb(var(--rgb-white) / 68%);
        font-size: .86rem;
        letter-spacing: .08em;
    }

    .view-loading::after {
        content: "";
        display: inline-block;
        width: .35rem;
        height: .35rem;
        margin-left: .55rem;
        border-radius: 50%;
        background: var(--color-accent-cyan);
        box-shadow:
            .55rem 0 rgb(var(--rgb-accent-cyan) / 62%),
            1.1rem 0 rgb(var(--rgb-accent-cyan) / 28%);
        animation: viewer-loading 1s ease-in-out infinite alternate;
    }

    .view-box.is-loading .view-loading,
    .view-box.has-error .view-error {
        display: block;
    }

    .view-caption {
        justify-self: center;
        max-width: min(80vw, 42rem);
        padding: .38rem .78rem;
        border-radius: 999px;
        color: rgb(var(--rgb-white) / 72%);
        background: rgb(var(--rgb-black) / 28%);
        font-size: .82rem;
        line-height: 1.5;
        text-align: center;
    }

    .view-details {
        display: grid;
        justify-items: center;
        gap: .45rem;
    }

    .view-references {
        width: min(82vw, 36rem);
        padding: .5rem .15rem 0;
        border-top: .12rem solid rgb(var(--rgb-accent-cyan) / 18%);
        user-select: text;
    }

    .view-references[hidden] {
        display: none;
    }

    .view-references > p {
        color: rgb(var(--rgb-white) / 58%);
        font-size: .7rem;
        line-height: 1.45;
        text-align: center;
    }

    #view-references-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: .25rem .8rem;
        margin-top: .25rem;
    }

    #view-references-list a {
        overflow: hidden;
        color: rgb(var(--rgb-white) / 76%);
        font-size: .68rem;
        font-weight: 600;
        line-height: 1.45;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition:
            color .18s cubic-bezier(.2, .7, .2, 1),
            opacity .18s cubic-bezier(.2, .7, .2, 1),
            transform .18s cubic-bezier(.2, .7, .2, 1);
    }

    #view-references-list a:hover,
    html[data-input-mode="keyboard"] #view-references-list a:focus-visible {
        color: var(--color-accent-cyan);
        outline: none;
    }

    #view-references-list a:active {
        transform: translateY(1px) scale(.98);
    }

    .view-tools {
        position: absolute;
        bottom: max(1rem, env(safe-area-inset-bottom));
        left: 50%;
        z-index: 3;
        display: grid;
        grid-template-columns: 2.35rem 3.8rem 2.35rem;
        overflow: hidden;
        border-radius: 999px;
        transform: translateX(-50%);
    }

    .view-tool,
    .view-scale {
        height: 2.15rem;
        border: 0;
        color: rgb(var(--rgb-white) / 76%);
        background: transparent;
        transition:
            color .2s ease,
            background-color .2s ease,
            transform .2s ease;
    }

    .view-tool:active,
    .view-scale:active {
        transform: translateY(1px) scale(.96);
    }

    .view-tool {
        font-size: 1.15rem;
    }

    .view-scale {
        border-right: 1px solid rgb(var(--rgb-white) / 10%);
        border-left: 1px solid rgb(var(--rgb-white) / 10%);
        font-size: .72rem;
    }

    .view-tool:hover,
    html[data-input-mode="keyboard"] .view-tool:focus-visible,
    .view-scale:hover,
    html[data-input-mode="keyboard"] .view-scale:focus-visible {
        color: var(--color-accent-cyan);
        background: var(--viewer-control-hover);
        outline: none;
    }

    .doc img:not(.view-none) {
        cursor: zoom-in;
    }

    html[data-input-mode="keyboard"] .doc img[role="button"]:focus-visible,
    html[data-input-mode="keyboard"] .moment-media-item:focus-visible {
        outline: 2px solid var(--color-brand);
        outline-offset: 3px;
    }

    html.dark[data-input-mode="keyboard"]
        .doc
        img[role="button"]:focus-visible,
    html.dark[data-input-mode="keyboard"] .moment-media-item:focus-visible {
        outline-color: var(--color-accent-cyan);
    }

    @keyframes viewer-loading {
        to {
            opacity: .35;
            transform: translateX(.15rem);
        }
    }

    @media (max-width: 640px) {
        .view-content {
            width: 94vw;
            height: 72dvh;
        }

        .view-tools {
            bottom: max(3.25rem, calc(env(safe-area-inset-bottom) + 2.25rem));
        }

        .view-nav {
            top: auto;
            bottom: max(1rem, env(safe-area-inset-bottom));
            transform: none;
        }

        .view-prev {
            left: max(.75rem, env(safe-area-inset-left));
        }

        .view-next {
            right: max(.75rem, env(safe-area-inset-right));
        }

        .view-nav:hover,
        html[data-input-mode="keyboard"] .view-nav:focus-visible {
            transform: scale(1.05);
        }

        .view-nav:active {
            transform: scale(.94);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .view-box,
        .view-control,
        .view-img,
        .view-video {
            transition: none;
        }

        .view-loading::after {
            animation: none;
        }
    }
</style>
