<button
  id="themeToggle"
  class="themeToggle"
  type="button"
  aria-label="切换到深色模式"
>
  <svg width="30px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
    <path
      class="sun"
      fill-rule="evenodd"
      d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
    ></path>
    <path
      class="moon"
      fill-rule="evenodd"
      d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
    ></path>
  </svg>
</button>

<style>
  #themeToggle {
    position: relative;
    top: 0.6rem;
    left: 0.6rem;
    border: 0;
    background: none;
    user-select: none;
    cursor: pointer;
    transition: transform .18s cubic-bezier(.22, 1, .36, 1);
  }
  #themeToggle:active {
    transform: translateY(1px) scale(.94);
  }
  .sun {
    fill: var(--color-accent-cyan);
  }
  .moon {
    fill: var(--text-on-dark);
    opacity: 0;
    transform: rotate(-35deg) scale(.75);
  }
  .sun,
  .moon {
    transform-origin: 12px 12px;
    transition: opacity .4s cubic-bezier(.22, 1, .36, 1),
      transform .55s cubic-bezier(.22, 1, .36, 1);
  }

  :global(.dark) .sun {
    opacity: 0;
    transform: rotate(35deg) scale(.75);
  }
  :global(.dark) .moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  /* 仅主题切换使用快照淡化，不影响其他页面过渡或现有交互。 */
  :global(html.is-theme-transition::view-transition-group(root)) {
    animation: none;
  }
  :global(html.is-theme-transition::view-transition-old(root)) {
    animation: none;
    mix-blend-mode: normal;
  }
  :global(html.is-theme-transition::view-transition-new(root)) {
    animation: theme-light-arrives .55s cubic-bezier(.4, 0, .2, 1) both;
    mix-blend-mode: normal;
  }
  :global(html.is-theme-transition::view-transition) {
    pointer-events: none;
  }
  @keyframes theme-light-arrives {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun,
    .moon {
      transition: opacity .12s cubic-bezier(.22, 1, .36, 1);
      transform: none !important;
    }
    :global(html.is-theme-transition::view-transition-new(root)) {
      animation-duration: .12s;
    }
  }
</style>

<script>
  const themeButton = document.getElementById("themeToggle");
  const syncThemeButtonLabel = () => {
    const isDark = document.documentElement.classList.contains("dark");
    themeButton?.setAttribute(
      "aria-label",
      isDark ? "切换到浅色模式" : "切换到深色模式",
    );
  };
  syncThemeButtonLabel();

  const applyTheme = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");
    const isDark = element.classList.contains("dark");
    const theme = isDark ? "dark" : "light";
    element.style.colorScheme = theme;
    try {
      localStorage.setItem("theme", theme);
      localStorage.setItem("themeTs", String(Date.now()));
    } catch {
      // 存储不可用时仍允许在当前页面切换主题。
    }
    syncThemeButtonLabel();
  };

  let isSwitching = false;
  const handleToggleClick = async () => {
    if (isSwitching) return;
    if (!document.startViewTransition) {
      applyTheme();
      return;
    }
    isSwitching = true;
    document.documentElement.classList.add("is-theme-transition");
    try {
      const transition = document.startViewTransition(applyTheme);
      // 即使快照被浏览器跳过，主题更新仍会执行。
      await transition.finished;
    } finally {
      document.documentElement.classList.remove("is-theme-transition");
      isSwitching = false;
    }
  };

  if (themeButton) {
    themeButton.addEventListener("click", handleToggleClick);
  }
</script>
