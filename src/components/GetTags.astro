---
import { getDocsArticles } from "../utils/articles";

const allArticles = getDocsArticles();

const tagCounts = new Map<string, number>();
allArticles.forEach(post => {
    post.frontmatter.tags?.forEach((tag) => {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    });
});

const cardList = Array.from(tagCounts, ([tag, count]) => ({ tag, count }))
    .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, "zh-CN"));

const currentPath = Astro.url.pathname.replace(/\/+$/, "");
const currentTag = currentPath.startsWith("/tags/")
    ? decodeURIComponent(currentPath.slice("/tags/".length))
    : undefined;
const currentTagIndex = currentTag
    ? cardList.findIndex(({ tag }) => tag === currentTag)
    : -1;
const initialIndex = Math.max(currentTagIndex, 0);
const orderedCardList = currentTagIndex > 0
    ? [...cardList.slice(currentTagIndex), ...cardList.slice(0, currentTagIndex)]
    : cardList;
---

<section class="aside-tags-card">
  <div
    class="card-stack"
    id="card-stack"
    data-initial-index={initialIndex}
    role="region"
    aria-label="文章标签，使用方向键切换"
  >
    {orderedCardList.map((item) => (
      <a
        href={`/tags/${encodeURIComponent(item.tag)}`}
        class="message-card"
        aria-current={item.tag === currentTag ? "page" : undefined}
      >
        <span class="msg-hashtag">#</span>
        <span class="msg-name">{item.tag}</span>
        <span class="msg-count">{item.count}</span>
      </a>
    ))}
  </div>
  <div
    class="stack-footer"
    id="stack-footer"
    role="status"
    aria-live="polite"
  ></div>
</section>

<script>
(function() {
  const stack = document.getElementById('card-stack') as HTMLElement;
  const footer = document.getElementById('stack-footer') as HTMLElement;
  if (!stack || !footer) return;
  const matchedParticleHost = stack.closest<HTMLElement>('.aside-tags-card');
  if (!matchedParticleHost) return;
  const particleHost: HTMLElement = matchedParticleHost;

  let cards = Array.from(
    stack.querySelectorAll<HTMLAnchorElement>('.message-card'),
  );
  const total = cards.length;
  if (total === 0) return;

  const VISIBLE = 3;
  const DEPTH_STEP = 7;
  const DURATION = 280;
  const PARTICLE_COUNT = 26;
  const ENTER_EASE = 'cubic-bezier(.16,1,.3,1)';
  const EXIT_EASE = 'cubic-bezier(.4,0,1,1)';
  const EXIT_OPACITY_EASE = 'cubic-bezier(.86,0,.98,.2)';
  const DEPTH_OPACITY = [1, .97, .94, 0];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let isAnimating = false;
  let touchStartY = 0;
  const initialIndex = Number.parseInt(stack.dataset.initialIndex ?? '0', 10);
  let currentIndex = Number.isInteger(initialIndex) && initialIndex < total
    ? initialIndex
    : 0;

  function stackTransform(depth: number) {
    const safeDepth = Math.min(depth, VISIBLE);
    return `translate3d(0, ${safeDepth * DEPTH_STEP}px, 0)`;
  }

  function setDepth(card: HTMLAnchorElement, depth: number) {
    const safeDepth = Math.min(depth, VISIBLE);
    card.dataset.depth = String(safeDepth);
    card.style.transform = stackTransform(safeDepth);
    card.style.opacity = String(DEPTH_OPACITY[safeDepth]);
    card.style.zIndex = safeDepth < VISIBLE
      ? String(VISIBLE - safeDepth)
      : '0';
  }

  function layoutCards(animate: boolean) {
    cards.forEach((card, i) => {
      const isCurrent = i === 0;
      const depth = Math.min(i, VISIBLE);
      card.style.transition = animate && !reduceMotion.matches
        ? `transform ${DURATION}ms ${ENTER_EASE}, opacity 220ms ${ENTER_EASE}`
        : 'none';
      card.style.display = '';
      card.style.pointerEvents = 'none';
      card.tabIndex = isCurrent ? 0 : -1;
      card.setAttribute('aria-hidden', String(!isCurrent));
      setDepth(card, depth);

      if (i < VISIBLE) {
        if (i === 0) card.style.pointerEvents = 'auto';
      }
    });
    footer.textContent = `${(currentIndex % total) + 1} / ${total}`;
  }

  function emitDissolveParticles(card: HTMLAnchorElement) {
    if (reduceMotion.matches) return;

    const layer = document.createElement('span');
    layer.className = 'tag-dissolve-layer';
    layer.setAttribute('aria-hidden', 'true');

    const cardRect = card.getBoundingClientRect();
    const hostRect = particleHost.getBoundingClientRect();
    const cardStyle = window.getComputedStyle(card);
    const accentElement = card.querySelector<HTMLElement>('.msg-hashtag');
    const countElement = card.querySelector<HTMLElement>('.msg-count');
    const accentColor = accentElement
      ? window.getComputedStyle(accentElement).color
      : cardStyle.color;
    const countColor = countElement
      ? window.getComputedStyle(countElement).color
      : accentColor;
    const surfaceColor = cardStyle.backgroundColor;
    const edgeColor = cardStyle.borderTopColor;
    const surfaceFragmentColor = `color-mix(in srgb, ${surfaceColor} 84%, ${accentColor})`;
    const centerFragmentColor = `color-mix(in srgb, ${surfaceColor} 72%, ${accentColor})`;
    const width = cardRect.width;
    const height = cardRect.height;

    layer.style.left = `${cardRect.left - hostRect.left}px`;
    layer.style.top = `${cardRect.top - hostRect.top}px`;
    layer.style.width = `${width}px`;
    layer.style.height = `${height}px`;

    for (let i = 0; i < PARTICLE_COUNT; i += 1) {
      const particle = document.createElement('i');
      const isAccentFragment = i < 3;
      const isCountFragment = i >= 3 && i < 5;
      const isCenterFragment = i >= 5 && i < 13;
      const xRatio = ((i * 37) % 101) / 100;
      const centerRatio = ((i * 29) % 97) / 96;
      const yRatio = ((i * 53) % 97) / 96;
      const fragmentWidth = isAccentFragment || isCountFragment
        ? 1.8 + (i % 2) * .4
        : 1.7 + (i % 3) * .45 + (isCenterFragment ? .15 : 0);
      const fragmentHeight = fragmentWidth;
      const startX = isAccentFragment
        ? 8 + (i % 2) * 6
        : isCountFragment
          ? width - 20 + (i % 3) * 4
          : isCenterFragment
            ? width * .3 + centerRatio * width * .4
            : 5 + xRatio * (width - 10);
      const startY = isAccentFragment || isCountFragment
        ? height * .45 + ((i % 3) - 1) * 3
        : 4 + yRatio * (height - 8);
      const driftX = (((i * 17) % 19) - 9) * .65;
      const driftY = -22 - ((i * 11) % 17);
      const midX = driftX * .34;
      const midY = driftY * .52;
      const delay = Math.round(yRatio * 34 + (i % 3) * 5);
      const color = isAccentFragment
        ? accentColor
        : isCountFragment
          ? countColor
          : isCenterFragment
            ? centerFragmentColor
            : i % 8 === 0
              ? edgeColor
              : surfaceFragmentColor;

      particle.className = 'tag-dissolve-particle';
      particle.style.left = `${startX}px`;
      particle.style.top = `${startY}px`;
      particle.style.setProperty('--particle-width', `${fragmentWidth}px`);
      particle.style.setProperty('--particle-height', `${fragmentHeight}px`);
      particle.style.setProperty('--particle-color', color);
      particle.style.setProperty('--particle-break-x', `${driftX * .12}px`);
      particle.style.setProperty('--particle-break-y', `${driftY * .14}px`);
      particle.style.setProperty('--particle-mid-x', `${midX}px`);
      particle.style.setProperty('--particle-mid-y', `${midY}px`);
      particle.style.setProperty('--particle-tail-x', `${driftX * .72}px`);
      particle.style.setProperty('--particle-tail-y', `${driftY * .82}px`);
      particle.style.setProperty('--particle-x', `${driftX}px`);
      particle.style.setProperty('--particle-y', `${driftY}px`);
      particle.style.setProperty('--particle-delay', `${delay}ms`);
      particle.style.setProperty('--particle-duration', `${580 + (i % 5) * 20}ms`);
      layer.appendChild(particle);
    }

    particleHost.appendChild(layer);
    window.setTimeout(() => {
      layer.remove();
    }, 740);
  }

  function dismissTop(focusNext = false) {
    if (isAnimating || total <= 1) return;
    isAnimating = true;

    const top = cards[0];
    emitDissolveParticles(top);

    const exitDuration = reduceMotion.matches ? 100 : 240;
    const opacityDuration = exitDuration;
    const settleDuration = reduceMotion.matches ? 120 : DURATION;
    top.style.transition =
      `transform ${exitDuration}ms ${EXIT_EASE}, opacity ${opacityDuration}ms ${EXIT_OPACITY_EASE}`;
    top.style.transform = reduceMotion.matches
      ? 'translate3d(0, -6px, 0)'
      : 'translate3d(0, -12px, 0)';
    top.style.opacity = '0';
    top.style.zIndex = String(VISIBLE + 1);

    for (let i = 1; i <= VISIBLE && i < cards.length; i += 1) {
      const card = cards[i];
      const targetDepth = i - 1;
      card.style.display = '';
      card.style.transition = reduceMotion.matches
        ? 'opacity 100ms cubic-bezier(.16,1,.3,1)'
        : `transform ${settleDuration}ms ${ENTER_EASE}, opacity 220ms ${ENTER_EASE}`;
      setDepth(card, targetDepth);
    }

    setTimeout(() => {
      stack.appendChild(top);
      cards = Array.from(
        stack.querySelectorAll<HTMLAnchorElement>('.message-card'),
      );
      currentIndex = (currentIndex + 1) % total;

      layoutCards(false);
      cards.forEach(card => {
        card.style.transition = '';
      });
      isAnimating = false;
      if (focusNext) cards[0]?.focus({ preventScroll: true });
    }, settleDuration);
  }

  function restoreTop(focusNext = false) {
    if (isAnimating || total <= 1) return;
    isAnimating = true;

    const last = cards[cards.length - 1];
    const settleDuration = reduceMotion.matches ? 120 : DURATION;
    last.style.transition = 'none';
    last.style.display = '';
    last.dataset.depth = '0';
    last.style.transform = reduceMotion.matches
      ? 'translate3d(0, -6px, 0)'
      : 'translate3d(0, -24px, 0)';
    last.style.opacity = '0';
    last.style.zIndex = String(VISIBLE + 1);
    last.style.pointerEvents = 'none';

    for (let i = 0; i < VISIBLE && i < cards.length - 1; i += 1) {
      const card = cards[i];
      const targetDepth = Math.min(i + 1, VISIBLE);
      card.style.transition = reduceMotion.matches
        ? 'opacity 100ms cubic-bezier(.16,1,.3,1)'
        : `transform ${settleDuration}ms ${ENTER_EASE}, opacity 220ms ${ENTER_EASE}`;
      setDepth(card, targetDepth);
    }

    void last.offsetHeight;

    last.style.transition = reduceMotion.matches
      ? 'opacity 100ms cubic-bezier(.16,1,.3,1)'
      : `transform ${settleDuration}ms ${ENTER_EASE}, opacity 220ms ${ENTER_EASE}`;
    last.style.transform = stackTransform(0);
    last.style.opacity = '1';

    setTimeout(() => {
      stack.insertBefore(last, stack.firstChild);
      cards = Array.from(
        stack.querySelectorAll<HTMLAnchorElement>('.message-card'),
      );
      currentIndex = (currentIndex - 1 + total) % total;

      layoutCards(false);
      cards.forEach(card => {
        card.style.transition = '';
      });
      isAnimating = false;
      if (focusNext) cards[0]?.focus({ preventScroll: true });
    }, settleDuration);
  }

  stack.addEventListener('wheel', (e) => {
    e.preventDefault();
    if (e.deltaY > 0) dismissTop();
    else restoreTop();
  }, { passive: false });

  stack.addEventListener('touchstart', (e) => {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  stack.addEventListener('touchmove', (e) => {
    e.preventDefault();
  }, { passive: false });

  stack.addEventListener('touchend', (e) => {
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (dy < -20) dismissTop();
    else if (dy > 20) restoreTop();
  }, { passive: true });

  stack.addEventListener('keydown', (e) => {
    if (!(e.target instanceof HTMLAnchorElement)) return;

    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
      e.preventDefault();
      dismissTop(true);
    } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
      e.preventDefault();
      restoreTop(true);
    }
  });

  layoutCards(false);
  setTimeout(() => cards.forEach(c => c.style.transition = ''), 50);
})();
</script>
