---
import { getDocsArticles } from "../utils/articles";

const allArticles = getDocsArticles();

const tagCounts = new Map<string, number>();
allArticles.forEach(post => {
    post.frontmatter.tags?.forEach((tag) => {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    });
});

const cardList = Array.from(tagCounts, ([tag, count]) => ({ tag, count }))
    .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, "zh-CN"));

const currentPath = Astro.url.pathname.replace(/\/+$/, "");
const currentTag = currentPath.startsWith("/tags/")
    ? decodeURIComponent(currentPath.slice("/tags/".length))
    : undefined;
const currentTagIndex = currentTag
    ? cardList.findIndex(({ tag }) => tag === currentTag)
    : -1;
const initialIndex = Math.max(currentTagIndex, 0);
const orderedCardList = currentTagIndex > 0
    ? [...cardList.slice(currentTagIndex), ...cardList.slice(0, currentTagIndex)]
    : cardList;
---

<section class="aside-tags-card">
  <div
    class="card-stack"
    id="card-stack"
    data-initial-index={initialIndex}
    role="region"
    aria-label="文章标签，使用方向键切换"
  >
    {orderedCardList.map((item) => (
      <a
        href={`/tags/${encodeURIComponent(item.tag)}`}
        class="message-card"
        aria-current={item.tag === currentTag ? "page" : undefined}
      >
        <span class="msg-hashtag">#</span>
        <span class="msg-name">{item.tag}</span>
        <span class="msg-count">{item.count}</span>
      </a>
    ))}
  </div>
  <div
    class="stack-footer"
    id="stack-footer"
    role="status"
    aria-live="polite"
  ></div>
</section>

<script>
(function() {
  const stack = document.getElementById('card-stack') as HTMLElement;
  const footer = document.getElementById('stack-footer') as HTMLElement;
  if (!stack || !footer) return;
  const matchedParticleHost = stack.closest<HTMLElement>('.aside-tags-card');
  if (!matchedParticleHost) return;
  const particleHost: HTMLElement = matchedParticleHost;

  let cards = Array.from(
    stack.querySelectorAll<HTMLAnchorElement>('.message-card'),
  );
  const total = cards.length;
  if (total === 0) return;

  const VISIBLE = 3;
  const PEEK = 10;
  const DURATION = 350;
  const PARTICLE_COUNT = 24;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let isAnimating = false;
  let touchStartY = 0;
  const initialIndex = Number.parseInt(stack.dataset.initialIndex ?? '0', 10);
  let currentIndex = Number.isInteger(initialIndex) && initialIndex < total
    ? initialIndex
    : 0;

  function layoutCards(animate: boolean) {
    cards.forEach((card, i) => {
      const y = i * PEEK;
      const isCurrent = i === 0;
      card.style.transition = animate ? 'transform 0.3s ease, opacity 0.3s ease' : 'none';
      card.style.display = '';
      card.style.pointerEvents = 'none';
      card.tabIndex = isCurrent ? 0 : -1;
      card.setAttribute('aria-hidden', String(!isCurrent));

      if (i < VISIBLE) {
        card.style.transform = `translateY(${y}px)`;
        card.style.zIndex = String(VISIBLE - i);
        card.style.opacity = '1';
        if (i === 0) card.style.pointerEvents = 'auto';
      } else {
        card.style.transform = `translateY(${y}px)`;
        card.style.zIndex = '0';
        card.style.opacity = '0';
      }
    });
    footer.textContent = `${(currentIndex % total) + 1} / ${total}`;
  }

  function emitDissolveParticles(card: HTMLAnchorElement) {
    if (reduceMotion.matches) return;

    const layer = document.createElement('span');
    layer.className = 'tag-dissolve-layer';
    layer.setAttribute('aria-hidden', 'true');

    const cardRect = card.getBoundingClientRect();
    const hostRect = particleHost.getBoundingClientRect();
    const width = cardRect.width;
    const height = cardRect.height;
    for (let i = 0; i < PARTICLE_COUNT; i += 1) {
      const particle = document.createElement('i');
      const progress = i / (PARTICLE_COUNT - 1);
      const size = 4 + (i % 3);
      const driftX = ((i % 7) - 3) * 6 + (i % 2 ? 3 : -3);
      const driftY = -14 - (i % 5) * 7;

      particle.className = 'tag-dissolve-particle';
      particle.style.left = `${cardRect.left - hostRect.left + 5 + progress * (width - 10)}px`;
      particle.style.top = `${cardRect.top - hostRect.top + 5 + ((i * 11) % Math.max(height - 8, 1))}px`;
      particle.style.setProperty('--particle-size', `${size}px`);
      particle.style.setProperty('--particle-x', `${driftX}px`);
      particle.style.setProperty('--particle-y', `${driftY}px`);
      particle.style.setProperty('--particle-delay', `${(i % 5) * 12}ms`);
      particle.style.setProperty('--particle-duration', `${720 + (i % 5) * 55}ms`);
      particle.style.setProperty('--particle-rotate', `${(i % 2 ? 1 : -1) * (35 + i * 9)}deg`);
      layer.appendChild(particle);
    }

    particleHost.appendChild(layer);
    window.setTimeout(() => layer.remove(), 1050);
  }

  function dismissTop(focusNext = false) {
    if (isAnimating || total <= 1) return;
    isAnimating = true;

    const top = cards[0];
    emitDissolveParticles(top);

    top.style.transition = `transform ${DURATION}ms cubic-bezier(.4,0,.2,1), opacity ${DURATION * 0.85}ms ease`;
    top.style.transform = 'translateY(-80px)';
    top.style.opacity = '0';
    top.style.zIndex = '999';

    const second = cards[1];
    const third = cards[2];
    if (second) {
      second.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
      second.style.transform = 'translateY(0)';
    }
    if (third) {
      third.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
      third.style.transform = `translateY(${PEEK}px)`;
    }

    setTimeout(() => {
      stack.appendChild(top);
      cards = Array.from(
        stack.querySelectorAll<HTMLAnchorElement>('.message-card'),
      );
      currentIndex = (currentIndex + 1) % total;

      top.style.transition = 'none';
      const lastIdx = cards.length - 1;
      top.style.transform = `translateY(${lastIdx * PEEK}px)`;
      top.style.opacity = '0';
      top.style.zIndex = '0';
      top.style.pointerEvents = 'none';

      void top.offsetHeight;
      layoutCards(true);

      setTimeout(() => {
        cards.forEach(c => c.style.transition = '');
        isAnimating = false;
        if (focusNext) cards[0]?.focus({ preventScroll: true });
      }, DURATION);
    }, DURATION);
  }

  function restoreTop(focusNext = false) {
    if (isAnimating || total <= 1) return;
    isAnimating = true;

    const last = cards[cards.length - 1];
    const first = cards[0];
    const second = cards[1];

    if (first) {
      first.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
      first.style.transform = `translateY(${PEEK}px)`;
    }
    if (second) {
      second.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
      second.style.transform = `translateY(${2 * PEEK}px)`;
    }

    const restoreY = cards.length * PEEK;
    last.style.transition = 'none';
    last.style.display = '';
    last.style.transform = `translateY(${restoreY}px)`;
    last.style.opacity = '0.5';
    last.style.zIndex = '999';
    last.style.pointerEvents = 'none';

    void last.offsetHeight;

    last.style.transition = `transform ${DURATION}ms cubic-bezier(.4,0,.2,1), opacity ${DURATION * 0.85}ms ease`;
    last.style.transform = 'translateY(0)';
    last.style.opacity = '1';

    setTimeout(() => {
      stack.insertBefore(last, stack.firstChild);
      cards = Array.from(
        stack.querySelectorAll<HTMLAnchorElement>('.message-card'),
      );
      currentIndex = (currentIndex - 1 + total) % total;

      last.style.transition = 'none';
      const lastIdx = cards.length - 1;
      last.style.transform = `translateY(${lastIdx * PEEK}px)`;
      last.style.opacity = '0';
      last.style.zIndex = '0';

      void last.offsetHeight;
      layoutCards(true);

      setTimeout(() => {
        cards.forEach(c => c.style.transition = '');
        isAnimating = false;
        if (focusNext) cards[0]?.focus({ preventScroll: true });
      }, DURATION);
    }, DURATION);
  }

  stack.addEventListener('wheel', (e) => {
    e.preventDefault();
    if (e.deltaY > 0) dismissTop();
    else restoreTop();
  }, { passive: false });

  stack.addEventListener('touchstart', (e) => {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  stack.addEventListener('touchmove', (e) => {
    e.preventDefault();
  }, { passive: false });

  stack.addEventListener('touchend', (e) => {
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (dy < -20) dismissTop();
    else if (dy > 20) restoreTop();
  }, { passive: true });

  stack.addEventListener('keydown', (e) => {
    if (!(e.target instanceof HTMLAnchorElement)) return;

    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
      e.preventDefault();
      dismissTop(true);
    } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
      e.preventDefault();
      restoreTop(true);
    }
  });

  layoutCards(false);
  setTimeout(() => cards.forEach(c => c.style.transition = ''), 50);
})();
</script>
